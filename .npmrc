# Flat node_modules, because Expo's bundler needs it.
#
# pnpm's default is a strict tree: every package sees only what it declares.
# That is the better arrangement and it is why the API and web app catch a
# missing dependency at install time rather than in production.
#
# Metro cannot work that way. It resolves the app's entry point from the
# workspace root and expects to find packages in a single node_modules beneath
# it, so under the default layout the mobile app fails to bundle at all —
# "Unable to resolve module expo-router/entry". Expo documents hoisting as the
# fix for pnpm workspaces.
#
# The cost is real and worth stating: with a flat tree a package can import
# something it never declared and it will work, until the day that dependency
# moves. If a build fails on Render complaining about a package that works
# here, this is the first thing to suspect — add it to that package's
# package.json rather than relying on the hoist.
node-linker=hoisted
