{
  "name": "ld-erp-solution",
  "version": "1.0.0",
  "private": true,
  "description": "LD ERP Solution — AI-Powered ERP for Garment Manufacturing",
  "author": "LD Cotton Mills",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "db:generate": "pnpm --filter @ld-erp/database generate",
    "db:migrate": "pnpm --filter @ld-erp/database migrate",
    "db:studio": "pnpm --filter @ld-erp/database studio",
    "db:seed": "pnpm --filter @ld-erp/database seed",
    "format": "prettier --write .",
    "dev:mobile": "pnpm --filter mobile dev",
    "build:mobile": "pnpm --filter mobile type-check"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^20.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.5.0"
  }
}
