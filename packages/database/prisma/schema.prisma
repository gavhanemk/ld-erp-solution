  @@map("payment_receipts")
}

// ═══════════════════════════════════════════
// PURCHASE
// ═══════════════════════════════════════════

/// How far an enquiry has got.
///
/// Read off the quotes under it, never written by hand. One enquiry can go to
/// three suppliers; it is SENT once any of them has it, QUOTED once any of them
/// has answered, and ORDERED once a live purchase order stands on it.
///
/// Part-ordering is ordinary — the mill orders 600 of the 1,240 quoted because
/// that is what the winning supplier will hold the price on — so an ORDERED
/// enquiry still has to show the other 640 as quoted but unplaced.
enum PurchaseEnquiryStatus {
  /// Being prepared. Nothing has left the building.
  DRAFT
  /// With at least one supplier, waiting on rates.
  SENT
  /// At least one proforma invoice is recorded against it.
  QUOTED
  /// At least one purchase order has been raised from it.
  ORDERED
  /// Dropped, with a reason — every rate was too high, the job was cancelled.
  CLOSED
}

/// What the mill asks its suppliers before it commits to anything.
///
/// The old ERP calls this a *provisional PO*, and the chain it sits in is:
/// indent → provisional PO → supplier rates → purchase order. The step exists
/// because the buyer frequently does not know the rate. An enquiry goes out
/// carrying quantities and no prices; each supplier answers with a proforma
/// invoice — his own numbered document, quoting a rate and saying how long he
/// will hold it; the buyer compares what came back; and the purchase order is
/// raised against the winning PI's number.
///
/// **The question is here; the answers are in `quotes`.** One enquiry, many
/// suppliers. Holding a supplier on the enquiry itself was the first shape of
/// this and it could not answer the question the step exists for — *which of
/// them is cheapest* — without the buyer opening three documents side by side
/// and doing the arithmetic on paper.
///
/// **Its own document rather than a sixth `PurchaseOrderStatus`.** A
/// provisional order sitting in `purchase_orders` is read as a real one by
/// everything that does not explicitly exclude it, and far more code queries
/// purchase orders than looks at their status. An enquiry leaking in would tell
/// a buyer goods were coming that nobody had agreed to supply, put them on the
/// indent as bought, and offer a goods receipt against an order no supplier has
/// ever seen.
///
/// Nothing on this document commits the mill. That is the point of it, and it is
/// why an open enquiry does not reduce what an indent still needs ordered.
model PurchaseEnquiry {
  id            String                @id @default(cuid())
  enquiryNumber String                @unique
  enquiryDate   DateTime              @default(now())
  /// When the mill needs the goods. Printed, so a supplier quotes against a
  /// date instead of quoting a rate he cannot hold long enough to be useful.
  requiredDate  DateTime?
  status        PurchaseEnquiryStatus @default(DRAFT)

  /// Where the goods are wanted. Null means head office, which is how the old
  /// system's "HO" reads and what most enquiries are.
  locationId String?
  location   Warehouse? @relation("EnquiryLocation", fields: [locationId], references: [id])

  /// Whatever the mill needs quoted back — a job number, an indent slip, the
  /// buyer's own reference. Free text, as it is on the purchase order: every
  /// mill numbers these differently and a fixed format would fit none of them.
  reference String?

  /// Printed on the supplier's copy.
  notes  String?
  terms  String?
  /// Internal. A remark about a supplier is not always something to send him.
  remark String?

  /// Why it was dropped. A decision with no reason recorded gets taken again.
  closeReason String?
  closedAt    DateTime?

  createdById String
  createdBy   User     @relation("EnquiryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Recycle bin, as a purchase order has: the row stays, marked, and every
  /// list, count and lookup outside the bin itself passes over it.
  deletedAt   DateTime?
  deletedById String?

  lines          PurchaseEnquiryLine[]
  quotes         PurchaseEnquiryQuote[]
  attachments    PurchaseEnquiryAttachment[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([deletedAt])
  @@index([locationId])
  @@map("purchase_enquiries")
}

/// One line of the question: what we want, and how much of it.
///
/// Carries no rate any supplier gave. `expectedRate` is the mill's own view and
/// is usually empty; what each supplier quoted lives on his own
/// `PurchaseEnquiryQuoteLine`, because three suppliers answering the same line
/// give three different rates and only one column here could hold them.
model PurchaseEnquiryLine {
  id          String          @id @default(cuid())
  enquiryId   String
  enquiry     PurchaseEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item            @relation(fields: [itemId], references: [id])
  /// What we asked for in our own words, when it differs from the item name.
  description String?
  /// Copied from the item when the enquiry is raised, so correcting the master
  /// later does not change what the suppliers were asked about.
  hsnCode     String?
  qty         Decimal         @db.Decimal(10, 3)

  /// What the mill expects to pay, where the buyer has a view. Usually empty —
  /// an enquiry goes out precisely because nobody knows the rate. Where it is
  /// set it is worth keeping: the gap between it and what came back is the
  /// reason the buyer reads a PI twice.
  expectedRate Decimal? @db.Decimal(10, 2)

  sortOrder Int @default(0)

  /// The indent line this was raised to answer, where it came off the indent
  /// list rather than being typed. Null for an enquiry about something nobody
  /// requisitioned, which is ordinary.
  mrLineId String?
  mrLine   MaterialRequisitionLine? @relation(fields: [mrLineId], references: [id])

  /// What each supplier said about this line.
  quoteLines PurchaseEnquiryQuoteLine[]

  /// The order lines raised from this one.
  ///
  /// How much of the enquiry has been ordered is read off these rather than
  /// kept as a running total here, for the same reason the indent does it: a
  /// counter and the orders it counts drift apart the first time an order is
  /// cancelled, and then the buyer is told to order what they already ordered.
  poLines PurchaseOrderLine[]

  @@index([enquiryId])
  @@index([mrLineId])
  @@map("purchase_enquiry_lines")
}

/// One supplier's answer to the enquiry.
///
/// The row exists from the moment a supplier is added to the enquiry, before he
/// has been sent anything and long before he answers — so "asked three, two have
/// replied" is a fact the screen can state rather than infer from absence.
///
/// `piAmount` is the total *his* PI states and is deliberately not recomputed
/// from the rates on his quote lines: when his arithmetic and ours disagree the
/// buyer has to see that before ordering rather than have it silently corrected
/// into agreement.
model PurchaseEnquiryQuote {
  id         String          @id @default(cuid())
  enquiryId  String
  enquiry    PurchaseEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])

  /// When it actually went out, which is not the date on the enquiry. One
  /// drafted Monday and sent Wednesday starts this supplier's clock on
  /// Wednesday, and any later argument about how long he took runs from here.
  sentAt DateTime?

  /// The supplier's proforma invoice, as he wrote it. `piNumber` is his
  /// reference, and it is what goes onto the purchase order so the document he
  /// receives quotes the document he sent.
  piNumber     String?
  piDate       DateTime?
  piAmount     Decimal?  @db.Decimal(12, 2)
  /// How long he will hold the price. A rate that expired in August is not a
  /// rate, and an order raised against one is an argument waiting to happen.
  piValidUntil DateTime?
  piReceivedAt DateTime?

  /// Where the goods would be delivered, as a two-digit GST state code. Carried
  /// per supplier because it is his tax position that decides whether his rate
  /// reads as CGST+SGST or IGST, and two suppliers can sit in different states.
  placeOfSupplyCode String?

  /// Internal note about this supplier's answer. Never printed.
  remark String?

  /// Why this one was passed over, where the buyer said. Kept on the losing
  /// quotes as well as read off the winner, because "we went elsewhere" and
  /// "he never answered" are different things to tell him next time.
  declinedReason String?
  declinedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines          PurchaseEnquiryQuoteLine[]
  attachments    PurchaseEnquiryAttachment[]
  purchaseOrders PurchaseOrder[]

  /// One row per supplier per enquiry. Asking the same supplier twice on one
  /// enquiry is a mistake, not a second quote — a revised PI replaces the
  /// first on this row and the audit log holds what it said before.
  @@unique([enquiryId, supplierId])
  @@index([supplierId])
  @@map("purchase_enquiry_quotes")
}

/// What one supplier quoted for one line of the enquiry.
///
/// The cell of the comparison grid: enquiry lines down the side, suppliers
/// across the top. A missing row means he did not price that line, which is
/// different from quoting zero and is shown as different.
model PurchaseEnquiryQuoteLine {
  id            String               @id @default(cuid())
  quoteId       String
  quote         PurchaseEnquiryQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  enquiryLineId String
  enquiryLine   PurchaseEnquiryLine  @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)

  quotedRate Decimal? @db.Decimal(10, 2)
  /// His GST rate for the line, which is not always the one on our master and
  /// is his to state.
  gstRate    Decimal? @db.Decimal(5, 2)
  /// What he says he can deliver, where it differs from what was asked. A
  /// supplier who can only supply 800 of the 1,240 has answered the enquiry,
  /// and refusing to record that would lose the reason the buyer split the
  /// order between two of them.
  offeredQty Decimal? @db.Decimal(10, 3)
  /// His own note against the line — a pack size, a lead time, a substitute.
  remark     String?

  @@unique([quoteId, enquiryLineId])
  @@index([enquiryLineId])
  @@map("purchase_enquiry_quote_lines")
}

/// A file kept against an enquiry, or against one supplier's answer to it.
///
/// `quoteId` is what separates the two. A drawing or a specification belongs to
/// the enquiry and every supplier sees the same one; a scanned proforma invoice
/// belongs to the supplier who sent it, and filing it against the enquiry would
/// leave three PDFs in one list with nothing saying whose each was.
model PurchaseEnquiryAttachment {
  id        String                @id @default(cuid())
  enquiryId String
  enquiry   PurchaseEnquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  /// Set when the file is one supplier's paperwork rather than the mill's.
  quoteId   String?
  quote     PurchaseEnquiryQuote? @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// What the person called it on their own machine. Shown in the list; never
  /// used to build the storage path, because two people upload "scan.pdf".
  fileName     String
  storagePath  String   @unique
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation("EnquiryAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([enquiryId])
  @@index([quoteId])
  @@map("purchase_enquiry_attachments")
}

model PurchaseOrder {
  id                  String                @id @default(cuid())
  poNumber            String                @unique
  supplierId          String
  supplier            Supplier              @relation(fields: [supplierId], references: [id])
  poDate              DateTime              @default(now())
  deliveryDate        DateTime?
  status              PurchaseOrderStatus   @default(DRAFT)
  poType              String                @default("STANDARD")
  /// The enquiry this order came out of, where it came out of one.
  ///
  /// Null for an order typed straight in, which is most of them: a buyer who
  /// already knows the rate does not send an enquiry first. Where it is set,
  /// `enquiryNo` below is filled from that enquiry's PI number, so the order
  /// the supplier receives quotes the document the supplier sent.
  enquiryId           String?
  enquiry             PurchaseEnquiry?      @relation(fields: [enquiryId], references: [id])
  /// Which supplier's answer this order was raised against.
  ///
  /// Separate from the enquiry: the enquiry says what was asked, the quote
  /// says whose price won. Without it an enquiry sent to three suppliers
  /// could not say which of them the order went to, and `enquiryNo` would be
  /// a PI number with no way back to the document it came off.
  enquiryQuoteId      String?
  enquiryQuote        PurchaseEnquiryQuote? @relation(fields: [enquiryQuoteId], references: [id])
  /// The supplier's quotation or our enquiry that this order answers. Carried
  /// on the order because the first thing asked when a price is questioned
  /// months later is which quote it came from, and that answer lived only in
  /// somebody's email before now.
  ///
  /// Set from the enquiry's PI number when the order is raised from one, and
  /// free text otherwise — an order can answer a quote that never became an
  /// enquiry on this system, and refusing to record that would lose the
  /// reference entirely.
  enquiryNo           String?
  enquiryDate         DateTime?
  /// Whatever the mill needs to quote back — a job number, an indent slip, the
  /// buyer's own reference. Deliberately free text: every mill numbers these
  /// differently and a fixed format would fit none of them.
  reference           String?
  /// An internal note. Separate from `notes`, which is printed on the order the
  /// supplier receives — a remark about a supplier is not always something to
  /// send them.
  remark              String?
  /// Where the goods are delivered, as a two-digit GST state code. Compared
  /// against ours to decide whether the supplier should bill CGST+SGST or IGST.
  placeOfSupplyCode   String?
  subtotal            Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(12, 2)
  taxableAmount       Decimal               @default(0) @db.Decimal(12, 2)
  /// Split rather than one lump, so the order can be checked against the bill
  /// the supplier eventually sends.
  cgst                Decimal               @default(0) @db.Decimal(12, 2)
  sgst                Decimal               @default(0) @db.Decimal(12, 2)
  igst                Decimal               @default(0) @db.Decimal(12, 2)
  roundOff            Decimal               @default(0) @db.Decimal(6, 2)
  /// Anything the mill agrees to pay that is not one of the named charges and
  /// carries no GST of its own — the old ERP's "Other charges" box. Added
  /// after tax, which is why it is not part of `taxableAmount`.
  otherCharges        Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal               @default(0) @db.Decimal(12, 2)
  /// Where the supplier is told to deliver.
  deliveryWarehouseId String?
  deliveryWarehouse   Warehouse?            @relation(fields: [deliveryWarehouseId], references: [id])
  /// Set when the supplier ships straight to a customer instead of to us.
  /// It changes the tax: goods are taxed where they are delivered, so a
  /// customer in another state makes the supplier's bill IGST even though we
  /// are in theirs.
  deliveryCustomerId  String?
  deliveryCustomer    Customer?             @relation("PODeliveryCustomer", fields: [deliveryCustomerId], references: [id])
  /// The address as it read the day the order was raised. A customer moves;
  /// an order already with a supplier must not.
  deliveryAddress     String?
  /// The supplier's billing address, as it read the day the order was raised.
  ///
  /// Text, not a link to `SupplierAddress`, for the same reason
  /// `deliveryAddress` is: this is what is printed on the order the supplier
  /// is holding. Correcting a typo in the master, or retiring an address,
  /// must not quietly change what an order already sent says.
  supplierAddress     String?
  notes               String?
  terms               String?
  createdById         String
  createdBy           User                  @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?                 @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  /// When this order was put in the recycle bin, and by whom.
  ///
  /// Deleting an order does not remove it. The row stays, marked, and every
  /// list, count and lookup outside the bin itself passes over it — so as far
  /// as the mill is concerned it is gone, but it can be put back whole.
  ///
  /// A `deletedById` rather than a relation: it is read once, on the one
  /// screen that lists the bin, and a relation here would put a
  /// `deletedPurchaseOrders` back-reference on User that nothing else wants.
  deletedAt   DateTime?
  deletedById String?

  lines         PurchaseOrderLine[]
  charges       PurchaseOrderCharge[]
  grns          GRN[]
  invoices      PurchaseInvoice[]
  attachments   PurchaseOrderAttachment[]
  purchaseNotes PurchaseNote[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([enquiryId])
  @@index([enquiryQuoteId])
  /// Every list of orders filters on this, so it earns an index of its own.
  @@index([deletedAt])
  @@map("purchase_orders")
}

/// A file kept against a purchase order — the supplier's quotation, a sample
/// approval, a signed copy that came back.
///
/// The file itself lives in object storage, not in the database. What is kept
/// here is where it is and what it was called, because a row is cheap to read
/// and a blob in a row makes every query that touches the order slower.
///
/// `storagePath` is the whole address of the file. The bucket is private, so
/// nothing here is reachable without a link the API signs on request and which
/// expires — a purchase order is a commercial document and a guessable URL is
/// how those end up indexed.
model PurchaseOrderAttachment {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  /// What the person called it on their own machine. Shown in the list; never
  /// used to build the storage path, because two people upload "scan.pdf".
  fileName     String
  /// Where it sits in the bucket. Unique so a row can never point at a file
  /// another row also claims.
  storagePath  String        @unique
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  uploadedBy   User          @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([poId])
  @@map("purchase_order_attachments")
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  /// What we asked for in our own words, when it differs from the item name.
  description String?
  /// The garment style this material is being bought for, both ways round.
  ///
  /// `styleNo` is whatever the buyer typed. `styleId` is the master style it
  /// turned out to be, set only when the text matches a style's code exactly.
  ///
  /// Both, rather than one or the other, because each alone loses something.
  /// Free text alone lets "SH-1042" and "SH1042" sit side by side and stop
  /// reconciling against production. The relation alone cannot hold a style
  /// the mill has not set up yet — and on a purchase order that is common,
  /// because material is often bought before the style is entered. Keeping
  /// the text means nothing the buyer wrote is ever dropped; keeping the
  /// relation means the link is there whenever it can be made.
  styleNo     String?
  styleId     String?
  style       Style?        @relation(fields: [styleId], references: [id])
  /// Copied from the item when the order is raised, because an item's HSN can
  /// be corrected later and an order already sent must not change.
  hsnCode     String?
  qty         Decimal       @db.Decimal(10, 3)
  unitRate    Decimal       @default(0) @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(5, 2)
  gstRate     Decimal       @default(0) @db.Decimal(5, 2)
  amount      Decimal       @default(0) @db.Decimal(12, 2)
  receivedQty Decimal       @default(0) @db.Decimal(10, 3)
  pendingQty  Decimal       @default(0) @db.Decimal(10, 3)
  sortOrder   Int           @default(0)

  /// The enquiry line this was raised from, where the order came off an
  /// enquiry. It is what lets the enquiry say how much of what it quoted has
  /// actually been placed, and it survives the order being cancelled — which is
  /// the point, because a cancelled order has to put its quantity back on the
  /// enquiry as unplaced rather than leave it looking bought.
  enquiryLineId String?
  enquiryLine   PurchaseEnquiryLine? @relation(fields: [enquiryLineId], references: [id])

  /// The requisition line this was raised to answer, where it was raised from
  /// one.
  ///
  /// Null for an order typed from scratch, which is most of them and always
  /// will be — a buyer topping up consumables is answering nobody's indent.
  /// Where it is set, it is what lets the indent list say how much of a
  /// request has already been ordered, and it is why a purchase can be traced
  /// back to the job that needed it months later.
  mrLineId String?
  mrLine   MaterialRequisitionLine? @relation(fields: [mrLineId], references: [id])

  /// Set when the mill has decided the balance of this line is not coming and
  /// closed it short of the ordered quantity, rather than leaving the order
  /// "partially received" forever waiting on a delivery that will not arrive.
  ///
  /// Freezes `pendingQty` at 0 without touching `receivedQty` — the shortfall
  /// is recorded as never received, not quietly written off as if it were.
  /// Reversible: closing this is a decision, not a deletion, and the line can
  /// be reopened if the supplier does eventually make it up.
  shortClosed      Boolean   @default(false)
  shortCloseReason String?
  shortClosedAt    DateTime?
  shortClosedById  String?
  shortClosedBy    User?     @relation("PurchaseOrderLineShortClosedBy", fields: [shortClosedById], references: [id])

  grnLines GRNLine[]

  @@index([mrLineId])
  @@index([enquiryLineId])
  @@map("purchase_order_lines")
}

/// A delivery, as the gate saw it.
///
/// The paperwork below is not decoration. When a supplier's bill is queried
/// months later, what settles it is the gate entry, the challan the driver
/// handed over and the vehicle it came on — and in the mill's old system every
/// one of those had a box on this form. They were surveyed off the live
/// Absolute ERP on 18 Sep 2026 and added here on the same day, because a
/// receipt that cannot be tied back to a physical delivery is a receipt
/// nobody can defend.
///
/// All of it is optional. A receipt typed in a hurry with nothing but
/// quantities is still a receipt, and refusing to save one because the driver's
/// name was not known would put the stock figure behind the goods.
model GRN {
  id        String        @id @default(cuid())
  grnNumber String        @unique
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id])
  /// Carries the time as well as the day. The old form asked for the hour and
  /// the minute separately; two deliveries from the same supplier on one day
  /// are told apart by nothing else.
  grnDate   DateTime      @default(now())
  vehicleNo String?
  status    GRNStatus     @default(DRAFT)
  notes     String?

  /// The security gate's own record, written before the goods reach the store.
  /// It is the first independent trace that a delivery happened at all.
  gateEntryNo   String?
  gateEntryDate DateTime?

  /// The supplier's delivery challan — the document that physically travels
  /// with the goods. Often a range ("1872 - 1887") when one delivery covers
  /// several challans, which is why it is text and not a number.
  challanNo   String?
  challanDate DateTime?

  /// The supplier's own paperwork, as it arrived with the lorry.
  ///
  /// Recorded here as well as on the bill on purpose: the invoice turns up
  /// with the goods long before accounts book it, and the number caught at the
  /// gate is what the booked bill gets checked against.
  supplierBillNo      String?
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?

  /// How many bales, cartons or rolls came off the vehicle. A count of
  /// packages, not of goods — it is what the gate can verify without opening
  /// anything, and it is what a short delivery is argued over.
  packageCount Int?

  driverName String?

  /// Free text, all four, and deliberately so — they are reference numbers
  /// from other people's systems and the mill writes in them what it needs to
  /// find the delivery again.
  formNo      String?
  clientName  String?
  orderedBy   String?
  referenceNo String?

  /// A frozen copy of the address on the supplier's paperwork for this one
  /// delivery, the same way the order freezes the address it was raised
  /// against.
  ///
  /// Usually the order's own address, copied across when the receipt is
  /// booked. Changed here rather than assumed when this delivery's challan
  /// names a different branch of the supplier than the order was placed
  /// with — a supplier with a head office and three depots routinely ships
  /// from whichever one has the stock, and the bill that follows has to be
  /// checked against the address that is actually on it, not the one the
  /// order happened to carry.
  supplierAddress String?

  /// A frozen copy of the address of the mill's own store this delivery was
  /// booked in against — the old system's "Shipping Address", which names
  /// where the goods were received, not where they came from.
  ///
  /// Defaults to the order's own delivery warehouse, and can be changed on
  /// this one receipt when the driver actually turned up at a different gate
  /// than the order named. A snapshot, the same as `supplierAddress` above,
  /// so a warehouse's address edited later does not rewrite a receipt already
  /// printed. Separate from each line's own store — that decides which
  /// warehouse the stock is counted into, and a delivery can split across
  /// several; this is the one gate the lorry itself arrived at.
  shippingAddress String?

  /// Why this receipt was allowed to book in more than the order's own
  /// balance — asked for only when the excess is past the mill's configured
  /// tolerance (Settings → Preferences → Purchase). Kept on the receipt
  /// itself, not buried in an audit log, so the reason sits with the document
  /// an auditor actually opens when a bill is queried against the order.
  overReceiptReason String?

  /// Who recorded the receipt. Prints as "Prepared By" on the note, which is
  /// the line somebody signs against.
  createdById String?
  createdBy   User?   @relation("GRNCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         GRNLine[]
  qcRecords     InwardQC[]
  attachments   GRNAttachment[]
  purchaseNotes PurchaseNote[]

  @@map("grn")
}

/// A file kept against a receipt — the challan, the supplier's invoice, a
/// photo of a damaged carton. The bytes live in the bucket; this row is only
/// the pointer to them, on the same three-step pattern as an order's own
/// attachments.
///
/// Never required. A store keeper standing at the gate with a lorry waiting
/// must be able to save the receipt with nothing attached, and add the paper
/// later once it has been scanned.
model GRNAttachment {
  id           String   @id @default(cuid())
  grnId        String
  grn          GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String   @unique
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation("GRNAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([grnId])
  @@map("grn_attachments")
}

model GRNLine {
  id           String             @id @default(cuid())
  grnId        String
  grn          GRN                @relation(fields: [grnId], references: [id], onDelete: Cascade)
  /// The order line this was received against.
  ///
  /// `Restrict` for the same reason as the bill line: a receipt line with no
  /// order line behind it cannot be matched, and the guards that refuse
  /// editing an order with goods against it were only advisory while the
  /// database would quietly null this instead.
  poLineId     String?
  poLine       PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: Restrict)
  itemId       String
  item         Item               @relation(fields: [itemId], references: [id])
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  orderedQty   Decimal            @db.Decimal(10, 3)
  receivedQty  Decimal            @db.Decimal(10, 3)
  rejectedQty  Decimal            @default(0) @db.Decimal(10, 3)
  acceptedQty  Decimal            @db.Decimal(10, 3)
  batchNumber  String?
  batchDetails Json?
  unitRate     Decimal            @default(0) @db.Decimal(10, 2)
  amount       Decimal            @default(0) @db.Decimal(12, 2)

  billLines PurchaseInvoiceLine[]
  noteLines PurchaseNoteLine[]

  @@map("grn_lines")
}

model InwardQC {
  id             String   @id @default(cuid())
  grnId          String
  grn            GRN      @relation(fields: [grnId], references: [id])
  inspectedBy    String?
  inspectionDate DateTime @default(now())
  result         QCResult
  checklistData  Json?
  remarks        String?
  createdAt      DateTime @default(now())

  @@map("inward_qc")
}

model PurchaseInvoice {
  id                  String         @id @default(cuid())
  billNumber          String         @unique
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  supplierId          String
  supplier            Supplier       @relation(fields: [supplierId], references: [id])
  poId                String?
  po                  PurchaseOrder? @relation(fields: [poId], references: [id])
  billDate            DateTime       @default(now())
  dueDate             DateTime?
  subtotal            Decimal        @db.Decimal(12, 2)
  discountAmount      Decimal        @default(0) @db.Decimal(12, 2)
  taxableAmount       Decimal        @default(0) @db.Decimal(12, 2)
  cgst                Decimal        @default(0) @db.Decimal(12, 2)
  sgst                Decimal        @default(0) @db.Decimal(12, 2)
  igst                Decimal        @default(0) @db.Decimal(12, 2)
  /// Tax deducted at source on a contractor or brokerage bill. Recorded here so
  /// the payment of the net amount still settles the bill in full instead of
  /// leaving a permanent stub outstanding against the supplier.
  tdsSection          String?
  tdsRate             Decimal?       @db.Decimal(5, 2)
  tdsAmount           Decimal        @default(0) @db.Decimal(12, 2)
  /// GST payable by us rather than the supplier — common on transport and on
  /// bills from unregistered parties.
  isReverseCharge     Boolean        @default(false)
  roundOff            Decimal        @default(0) @db.Decimal(6, 2)
  totalAmount         Decimal        @db.Decimal(12, 2)
  paidAmount          Decimal        @default(0) @db.Decimal(12, 2)
  /// The net effect of every POSTED purchase note against this bill — positive
  /// where the notes reduce what is owed, which is the ordinary case.
  ///
  /// Summed from the notes and written here, never incremented, on the same
  /// footing as `paidAmount`: a running total that is added to on each note
  /// drifts the first time one is cancelled, and then nobody can say which
  /// figure is true. The notes are the record; this is their sum, put where a
  /// list screen can sort on it.
  noteAdjustment      Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount       Decimal        @db.Decimal(12, 2)
  status              InvoiceStatus  @default(UNPAID)
  notes               String?
  createdById         String
  createdBy           User           @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  payments    SupplierPayment[]
  lines       PurchaseInvoiceLine[]
  charges     PurchaseInvoiceCharge[]
  adjustments PurchaseNote[]
  /// Goods sent back against this bill, on a return challan each.
  returns     PurchaseReturn[]
  debitNotes  DebitNote[]

  /// The same supplier bill must never be booked twice — a duplicate claims the
  /// input credit a second time, which is the mistake a GST notice is written
  /// about. Postgres treats NULLs as distinct, so bills with no supplier number
  /// yet are unaffected.
  @@unique([supplierId, supplierInvoiceNo])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_invoices")
}

model SupplierPayment {
  id             String           @id @default(cuid())
  paymentNumber  String           @unique
  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  /// The bill this settles. Null for a payment on account.
  ///
  /// `Restrict`: the bill delete route already refuses a bill with payments
  /// against it, and set-null would have let a payment survive with nothing
  /// to reconcile it to.
  invoiceId      String?
  invoice        PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// Which of our places the payment is booked at — the old ERP's "Location",
  /// empty meaning head office. Kept on the payment rather than read from the
  /// bill because a unit can settle a bill the head office raised.
  warehouseId    String?
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// The account the money actually left — the old ERP's "Paid Through".
  /// Restrict, not set-null: a payment that forgets which account it came out
  /// of cannot be reconciled against a bank statement, and retiring an account
  /// is what `isActive` is for.
  bankAccountId  String?
  bankAccount    BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  paymentDate    DateTime         @default(now())
  amount         Decimal          @db.Decimal(12, 2)
  /// Tax withheld from this payment and owed to the government instead of to
  /// the supplier. Only ever set when the bill did not already record TDS —
  /// deducting in both places would pay the supplier twice short.
  tdsAmount      Decimal          @default(0) @db.Decimal(12, 2)
  mode           PaymentMode
  referenceNo    String?
  /// Its own column rather than borrowed from `referenceNo`, which already sat
  /// beside `chequeDate` with nothing to pair with. A cheque number is quoted
  /// back by the bank and searched on; a UTR is not the same thing.
  chequeNo       String?
  chequeDate     DateTime?
  notes          String?
  /// Whether this payment still counts.
  ///
  /// A bounced cheque had nowhere to go: the payment could only be deleted,
  /// which removed the evidence that the mill had ever tried to pay. Reversing
  /// keeps the record and stops it settling the bill, so the bill reopens for
  /// the amount and the trail still shows what happened.
  status         PaymentStatus    @default(POSTED)
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?            @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  /// Why. Required by the route — a reversal with no reason is unauditable.
  reversalReason String?
  createdById    String
  createdBy      User             @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  attachments SupplierPaymentAttachment[]

  @@index([supplierId])
  @@map("supplier_payments")
}

/// The bank advice, the cheque counterfoil, the UTR screenshot. Same shape as
/// the order and receipt attachments: the file lives in object storage and the
/// row only says where.
model SupplierPaymentAttachment {
  id           String          @id @default(cuid())
  paymentId    String
  payment      SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String          @unique
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  uploadedBy   User            @relation("PaymentAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([paymentId])
  @@map("supplier_payment_attachments")
}

// ═══════════════════════════════════════════
// INVENTORY
// ═══════════════════════════════════════════

model StockLedger {
  id              String          @id @default(cuid())
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  transactionType TransactionType
  referenceType   String?
  referenceId     String?
  batchNumber     String?
  /// Fabric a customer sends in for job work sits in our godown but is not our
  /// stock. Counting it as ours would inflate the stock value, the balance
  /// sheet and the GST position.
  ownership       StockOwnership  @default(OWNED)
  ownerCustomerId String?
  ownerCustomer   Customer?       @relation("CustomerOwnedStock", fields: [ownerCustomerId], references: [id])
  inQty           Decimal         @default(0) @db.Decimal(10, 3)
  outQty          Decimal         @default(0) @db.Decimal(10, 3)
  closingStock    Decimal         @db.Decimal(10, 3)
  unitRate        Decimal?        @db.Decimal(10, 2)
  transactionDate DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([itemId, warehouseId])
  @@index([transactionDate])
  @@index([ownership, ownerCustomerId])
  @@map("stock_ledger")
}

/// A department asking the store for material. This is the document that takes
/// stock out for production, so it carries three different people: who asked,
/// who allowed it, and who actually handed it over. They are separate columns
/// because docs/04-business-rules.md forbids the person who raised a document
/// from approving it, and that rule cannot be enforced against a single name.
/// Where a requisitioned item is to come from.
///
/// The mill's old ERP calls a requisition an *indent*, and its purchase order
/// form opens straight onto the indent lines nobody has bought yet — tick
/// them, set a quantity, and they drop into the order. That only works if a
/// line says whether it is a call on the store or a call on the buyer, because
/// the two are answered by different people in different rooms.
///
/// FROM_STOCK is the default and is what this model did before: the store
/// issues it off the rack. PURCHASE means there is none to issue and it has to
/// be bought, so the line waits on the purchase order form instead.
enum RequisitionFulfilment {
  FROM_STOCK
  PURCHASE
}

model MaterialRequisition {
  id              String              @id @default(cuid())
  mrNumber        String              @unique
  moId            String?
  mo              ManufacturingOrder? @relation(fields: [moId], references: [id])
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])
  requestDate     DateTime            @default(now())
  requiredDate    DateTime?
  status          ApprovalStatus      @default(PENDING)
  raisedById      String?
  raisedBy        User?               @relation("MRRaisedBy", fields: [raisedById], references: [id])
  approvedById    String?
  approvedBy      User?               @relation("MRApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  /// Set the moment stock actually moves. A requisition can be approved on
  /// Monday and issued on Wednesday, and the stock date is Wednesday.
  issuedById      String?
  issuedBy        User?               @relation("MRIssuedBy", fields: [issuedById], references: [id])
  issuedAt        DateTime?
  /// Why it was refused. A rejection with no reason just gets raised again.
  rejectionReason String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lines MaterialRequisitionLine[]

  @@index([status])
  @@map("material_requisitions")
}

model MaterialRequisitionLine {
  id           String              @id @default(cuid())
  mrId         String
  mr           MaterialRequisition @relation(fields: [mrId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item                @relation(fields: [itemId], references: [id])
  requestedQty Decimal             @db.Decimal(10, 3)
  issuedQty    Decimal             @default(0) @db.Decimal(10, 3)
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  purpose      String?

  /// Issue it off the rack, or buy it. Defaults to the rack, which is what
  /// every line written before this existed meant.
  fulfilment RequisitionFulfilment @default(FROM_STOCK)

  /// The enquiry lines raised against this one.
  ///
  /// Shown to the buyer, but never subtracted from what the request still
  /// needs: an enquiry is a question, not a purchase. Without it a buyer cannot
  /// tell a request nobody has looked at from one already out with a supplier,
  /// and enquires about it a second time.
  enquiryLines PurchaseEnquiryLine[]

  /// The order lines raised against this one.
  ///
  /// How much of the request has been ordered is read off these rather than
  /// kept as a running total on the line. A counter and the orders it counts
  /// drift apart the first time an order is cancelled, and then the buyer is
  /// told to order what they already ordered.
  poLines PurchaseOrderLine[]

  @@index([fulfilment])
  @@map("material_requisition_lines")
}

/// Moving our own stock from one of our stores to another.
///
/// The movement used to leave nothing behind but ledger rows tagged with the
/// clock — `TRF-1788857668962` — which is not a document. Nobody could list
/// what had been moved this month, reprint the slip the storekeeper hands over
/// with the goods, or take a wrong movement back out. The rows now point at
/// this, and it carries a real number from the series like every other
/// document in the system.
model StockTransfer {
  id              String    @id @default(cuid())
  transferNumber  String    @unique
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  transferDate    DateTime  @default(now())
  notes           String?
  movedById       String?
  movedBy         User?     @relation("TransferMovedBy", fields: [movedById], references: [id])
  /// Set when the movement is taken back out. The document and its number stay
  /// — a cancelled transfer is still a thing that happened, and its number is
  /// never handed to another document.
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?     @relation("TransferCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lines StockTransferLine[]

  @@index([transferDate])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  qty        Decimal       @db.Decimal(10, 3)
  /// What the stock was carried at when it moved, copied onto the line so the
  /// note prints the same figure next year. Moving cloth across the yard must
  /// not change what it is worth, and this is the record of that.
  unitRate   Decimal?      @db.Decimal(10, 2)

  @@map("stock_transfer_lines")
}

/// A correction after somebody has physically counted the rack.
///
/// This is the one movement with no document behind it in the real world: it
/// says the book was wrong. That is exactly why it needs one here — an
/// unexplained change to a stock figure is the first thing a stock audit asks
/// about, and until now the answer lived only in a ledger note.
///
/// There is no cancelling an adjustment. It records what was counted on a day;
/// if the count itself was wrong, you count again and adjust again, and both
/// corrections stay on the record.
model StockAdjustment {
  id               String    @id @default(cuid())
  adjustmentNumber String    @unique
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  adjustmentDate   DateTime  @default(now())
  /// Why the figure was changed. Never optional.
  reason           String
  madeById         String?
  madeBy           User?     @relation("AdjustmentMadeBy", fields: [madeById], references: [id])
  createdAt        DateTime  @default(now())

  lines StockAdjustmentLine[]

  @@index([adjustmentDate])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item            @relation(fields: [itemId], references: [id])
  /// What the book said at the moment of counting. Kept so the correction can
  /// be read back later without replaying the whole ledger to that date.
  bookQty      Decimal         @db.Decimal(10, 3)
  countedQty   Decimal         @db.Decimal(10, 3)
  /// Counted minus book. Negative means stock was missing off the rack.
  difference   Decimal         @db.Decimal(10, 3)
  unitRate     Decimal?        @db.Decimal(10, 2)

  @@map("stock_adjustment_lines")
}

// ═══════════════════════════════════════════
// PRODUCTION
// ═══════════════════════════════════════════

model ManufacturingOrder {
  id               String      @id @default(cuid())
  moNumber         String      @unique
  soId             String?
  so               SalesOrder? @relation(fields: [soId], references: [id])
  brandId          String
  brand            Brand       @relation(fields: [brandId], references: [id])
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           MOStatus    @default(DRAFT)
  totalPlannedQty  Int         @default(0)
  totalCutQty      Int         @default(0)
  totalStitchedQty Int         @default(0)
  totalFinishedQty Int         @default(0)
  totalPackedQty   Int         @default(0)
  notes            String?
  createdById      String
  createdBy        User        @relation("MOCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  lines                MOLine[]
  materialRequisitions MaterialRequisition[]
  cuttingOrders        CuttingOrder[]
  productionEntries    ProductionEntry[]
  qcRecords            ProductionQC[]
  packingOrders        PackingOrder[]

  @@index([moNumber])
  @@index([status])
  @@map("manufacturing_orders")
}

model MOLine {
  id       String             @id @default(cuid())
  moId     String
  mo       ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  styleId  String
  style    Style              @relation(fields: [styleId], references: [id])
  color    String
  totalQty Int

  sizes MOLineSize[]

  @@map("mo_lines")
}

model CuttingOrder {
  id               String             @id @default(cuid())
  cutOrderNumber   String             @unique
  moId             String
  mo               ManufacturingOrder @relation(fields: [moId], references: [id])
  cutDate          DateTime           @default(now())
  fabricWidth      Decimal?           @db.Decimal(5, 2)
  fabricGSM        Int?
  shrinkagePercent Decimal?           @db.Decimal(4, 2)
  noOfLayers       Int?
  fabricIssued     Decimal?           @db.Decimal(10, 3)
  fabricUsed       Decimal?           @db.Decimal(10, 3)
  wastage          Decimal?           @db.Decimal(10, 3)
  plannedPieces    Int
  actualPieces     Int                @default(0)
  sizeBreakup      Json?
  status           CuttingStatus      @default(PENDING)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("cutting_orders")
}

model ProductionEntry {
  id            String             @id @default(cuid())
  moId          String
  mo            ManufacturingOrder @relation(fields: [moId], references: [id])
  entryDate     DateTime           @default(now())
  departmentId  String
  department    Department         @relation(fields: [departmentId], references: [id])
  /// Which line or outside unit produced this. Without it, what is owed to a
  /// job-work unit can never be totalled.
  workstationId String?
  workstation   Workstation?       @relation(fields: [workstationId], references: [id])
  shift         String?
  target        Int
  achieved      Int
  rejection     Int                @default(0)
  rework        Int                @default(0)
  efficiency    Decimal?           @db.Decimal(5, 2)
  operationId   String?
  operation     Operation?         @relation(fields: [operationId], references: [id])
  notes         String?
  enteredBy     String?
  createdAt     DateTime           @default(now())

  @@index([moId])
  @@index([entryDate])
  @@map("production_entries")
}

model ProductionQC {
