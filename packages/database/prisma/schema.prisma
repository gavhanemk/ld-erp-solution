// ═══════════════════════════════════════════
// PARTIES — AGENTS
// ═══════════════════════════════════════════

/// A commission agent who brings buyers. LD runs eleven of them plus "SELF" for
/// direct sales, pays brokerage on the invoice value, and deducts TDS under
/// section 194H — so this is real money that needs a ledger, not a note.
model Broker {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  address          String?
  city             String?
  state            String?
  stateCode        String?
  /// Default commission, overridable per customer and per order.
  brokeragePercent Decimal  @default(0) @db.Decimal(5, 2)
  /// TDS section applied to this agent's commission, e.g. "194H".
  tdsSection       String?
  tdsRate          Decimal? @db.Decimal(5, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customers   Customer[]
  salesOrders SalesOrder[]
  invoices    SalesInvoice[]

  @@index([code])
  @@map("brokers")
}

// ═══════════════════════════════════════════
// SHOP FLOOR — WORKSTATIONS, ROUTING, SIZES
// ═══════════════════════════════════════════

/// Where work physically happens. At LD most of these are not machines on our
/// own floor — many are outside job-work units. Linking one to the supplier
/// Enterprises. Linking one to a supplier is what makes their job-work bill
/// addable at the end of the month.
model Workstation {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  type           WorkstationType @default(IN_HOUSE)
  /// Set when type is JOB_WORK — the party we pay for this work.
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  capacityPerDay Int?
  address        String?
  contactPerson  String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  productionEntries ProductionEntry[]
  routingSteps      RoutingStep[]

  @@index([code])
  @@map("workstations")
}

/// The ordered path a style takes through the factory. No two styles take the
/// same one: a plain shirt skips washing, an embroidered one adds two steps.
model Routing {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  styleId   String
  style     Style    @relation(fields: [styleId], references: [id])
  /// Locked routings cannot be edited while orders are running against them.
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps RoutingStep[]

  @@index([styleId])
  @@map("routings")
}

model RoutingStep {
  id            String       @id @default(cuid())
  routingId     String
  routing       Routing      @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequence      Int
  operationId   String
  operation     Operation    @relation(fields: [operationId], references: [id])
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  /// Optional: the specific unit this step is normally sent to.
  workstationId String?
  workstation   Workstation? @relation(fields: [workstationId], references: [id])
  smv           Decimal?     @db.Decimal(5, 3)
  ratePerPiece  Decimal?     @db.Decimal(10, 2)
  isQcStep      Boolean      @default(false)

  @@unique([routingId, sequence])
  @@map("routing_steps")
}

/// A named size run, e.g. "Men's Shirt S–XXL". Replaces free-text size arrays.
model SizeGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  gender    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sizes  Size[]
  styles Style[]

  @@map("size_groups")
}

model Size {
  id          String    @id @default(cuid())
  sizeGroupId String
  sizeGroup   SizeGroup @relation(fields: [sizeGroupId], references: [id], onDelete: Cascade)
  code        String
  label       String
  sequence    Int       @default(0)

  soLineSizes SalesOrderLineSize[]
  moLineSizes MOLineSize[]

  @@unique([sizeGroupId, code])
  @@map("sizes")
}

model SalesOrderLineSize {
  id     String         @id @default(cuid())
  lineId String
  line   SalesOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sizeId String
  size   Size           @relation(fields: [sizeId], references: [id])
  qty    Decimal        @db.Decimal(10, 2)

  @@unique([lineId, sizeId])
  @@map("sales_order_line_sizes")
}

model MOLineSize {
  id       String @id @default(cuid())
  moLineId String
  moLine   MOLine @relation(fields: [moLineId], references: [id], onDelete: Cascade)
  sizeId   String
  size     Size   @relation(fields: [sizeId], references: [id])
  qty      Int

  @@unique([moLineId, sizeId])
  @@map("mo_line_sizes")
}

// ═══════════════════════════════════════════
// DOCUMENT LINES AND CHARGES
// ═══════════════════════════════════════════

model SalesInvoiceLine {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item         @relation(fields: [itemId], references: [id])
  description  String?
  /// Copied onto the line at the time of billing, because an item's HSN can be
  /// corrected later and an issued invoice must never change.
  hsnCode      String?
  qty          Decimal      @db.Decimal(10, 3)
  unitPrice    Decimal      @db.Decimal(10, 2)
  discount     Decimal      @default(0) @db.Decimal(5, 2)
  taxableValue Decimal      @default(0) @db.Decimal(12, 2)
  gstRate      Decimal      @default(0) @db.Decimal(5, 2)
  cgst         Decimal      @default(0) @db.Decimal(12, 2)
  sgst         Decimal      @default(0) @db.Decimal(12, 2)
  igst         Decimal      @default(0) @db.Decimal(12, 2)
  amount       Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder    Int          @default(0)

  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

model PurchaseInvoiceLine {
  id           String          @id @default(cuid())
  billId       String
  bill         PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item            @relation(fields: [itemId], references: [id])
  /// The receipt line this bill line settles, which is what makes the
  /// three-way match possible: ordered, received and billed have to agree one
  /// row at a time. Held per line rather than once on the bill, because a
  /// supplier routinely bills several deliveries together — and because a bill
  /// line for something never received is exactly what the match must catch.
  /// The receipt line this bill line settles.
  ///
  /// `Restrict`, not the default set-null. Set-null made the GRN_BILLED guard
  /// on the receipt delete route dead code: the receipt went, its stock came
  /// back out, and the bill line survived pointing at nothing — so that bill
  /// was never three-way matched again and nobody could see why. Proved in a
  /// rolled-back transaction before it was changed.
  grnLineId    String?
  grnLine      GRNLine?        @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  description  String?
  hsnCode      String?
  qty          Decimal         @db.Decimal(10, 3)
  unitPrice    Decimal         @db.Decimal(10, 2)
  discount     Decimal         @default(0) @db.Decimal(5, 2)
  taxableValue Decimal         @default(0) @db.Decimal(12, 2)
  gstRate      Decimal         @default(0) @db.Decimal(5, 2)
  cgst         Decimal         @default(0) @db.Decimal(12, 2)
  sgst         Decimal         @default(0) @db.Decimal(12, 2)
  igst         Decimal         @default(0) @db.Decimal(12, 2)
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  sortOrder    Int             @default(0)

  /// Adjustments raised against this line. What is left to adjust is this
  /// line's quantity less what these already claim.
  noteLines   PurchaseNoteLine[]
  /// Goods physically sent back against this line.
  returnLines PurchaseReturnLine[]

  @@index([billId])
  @@map("purchase_invoice_lines")
}

/// The chargeable extras LD already bills: transport, freight, dyeing. Each
/// carries its own GST rate, so it cannot be folded into the goods value.
model ChargeType {
  id              String   @id @default(cuid())
  name            String   @unique
  /// The GST charged ON this charge — 5% on dyeing, 18% on freight. Not a
  /// share of the order: that is `percentOfValue` below, and confusing the two
  /// puts 58% of an order's value into its charge rows.
  defaultGstRate  Decimal  @default(0) @db.Decimal(5, 2)
  /// What this charge usually comes to as a share of the order — 5% of the
  /// goods for transport, say. Set under Masters -> Charges.
  ///
  /// Never applied on its own, and a charge is still typed in on every order:
  /// what a transporter asks for is agreed on a call, not derived. This is the
  /// figure the purchase order's percentage helper opens at, so the usual rate
  /// takes one press rather than a calculator. 0 means unset.
  ///
  /// Dead from Sep 17 to Sep 18 2026, when the buyers asked for exactly the
  /// thing it had been added for.
  percentOfValue  Decimal  @default(0) @db.Decimal(5, 2)
  applyOnSale     Boolean  @default(true)
  applyOnPurchase Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  salesCharges         SalesInvoiceCharge[]
  purchaseCharges      PurchaseInvoiceCharge[]
  purchaseOrderCharges PurchaseOrderCharge[]

  @@map("charge_types")
}

model SalesInvoiceCharge {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  chargeTypeId String
  chargeType   ChargeType   @relation(fields: [chargeTypeId], references: [id])
  amount       Decimal      @db.Decimal(12, 2)
  gstRate      Decimal      @default(0) @db.Decimal(5, 2)
  cgst         Decimal      @default(0) @db.Decimal(12, 2)
  sgst         Decimal      @default(0) @db.Decimal(12, 2)
  igst         Decimal      @default(0) @db.Decimal(12, 2)

  @@map("sales_invoice_charges")
}

/// A charge on a purchase order — transport, freight, dyeing.
///
/// Deliberately the same shape as `PurchaseInvoiceCharge`, so a charge the
/// mill agreed on the order and the charge that turns up on the bill can be
/// compared line for line by the three-way match. Six named columns on the
/// order would have been quicker to write and would have baked today's GST
/// rates into column names; the mill has renamed and re-rated these before.
model PurchaseOrderCharge {
  id           String        @id @default(cuid())
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  chargeTypeId String
  chargeType   ChargeType    @relation(fields: [chargeTypeId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  /// Copied from the charge type when the order is raised. A rate corrected in
  /// the master next week must not silently change an order already sent.
  gstRate      Decimal       @default(0) @db.Decimal(5, 2)
  cgst         Decimal       @default(0) @db.Decimal(12, 2)
  sgst         Decimal       @default(0) @db.Decimal(12, 2)
  igst         Decimal       @default(0) @db.Decimal(12, 2)

  @@unique([poId, chargeTypeId])
  @@index([poId])
  @@map("purchase_order_charges")
}

model PurchaseInvoiceCharge {
  id           String          @id @default(cuid())
  billId       String
  bill         PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Cascade)
  chargeTypeId String
  chargeType   ChargeType      @relation(fields: [chargeTypeId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  gstRate      Decimal         @default(0) @db.Decimal(5, 2)
  cgst         Decimal         @default(0) @db.Decimal(12, 2)
  sgst         Decimal         @default(0) @db.Decimal(12, 2)
  igst         Decimal         @default(0) @db.Decimal(12, 2)

  @@map("purchase_invoice_charges")
}

// ═══════════════════════════════════════════
// SALES RETURNS
// ═══════════════════════════════════════════

/// Issued to a customer when goods come back or a bill is reduced. Without it a
/// return leaves the original invoice standing and overstates GST payable.
model CreditNote {
  id          String        @id @default(cuid())
  noteNumber  String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceId   String?
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  noteDate    DateTime      @default(now())
  reason      String?
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  cgst        Decimal       @default(0) @db.Decimal(12, 2)
  sgst        Decimal       @default(0) @db.Decimal(12, 2)
  igst        Decimal       @default(0) @db.Decimal(12, 2)
  roundOff    Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  status      NoteStatus    @default(DRAFT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines CreditNoteLine[]

  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  noteId       String
  note         CreditNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])
  description  String?
  hsnCode      String?
  qty          Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 2)
  taxableValue Decimal    @default(0) @db.Decimal(12, 2)
  gstRate      Decimal    @default(0) @db.Decimal(5, 2)
  amount       Decimal    @default(0) @db.Decimal(12, 2)
  sortOrder    Int        @default(0)

  @@map("credit_note_lines")
}

// ═══════════════════════════════════════════
// PURCHASE ADJUSTMENTS
// ═══════════════════════════════════════════

/// Who raised the adjustment — ours or theirs.
///
/// Held on its own because it is the one fact a purchase clerk always knows
/// for certain, and because it is not the same question as what kind of
/// document resulted. We can raise a claim the supplier never answers; the
/// supplier can send a note we never asked for.
enum PurchaseAdjustmentIssuer {
  OUR_COMPANY
  SUPPLIER
}

/// What kind of document this actually is.
///
/// Deliberately NOT two values. "Debit note" and "credit note" are a pair only
/// if you assume every adjustment comes off the bill, and that assumption is
/// what this enum exists to break: a supplier who undercharged raises a debit
/// note ON us and the payable goes UP. Collapsing that into a DEBIT/CREDIT
/// flag moved money the wrong way and read as correct while doing it.
///
/// OUR_DEBIT_NOTE is a commercial claim, not a GST document. Whether it ever
/// becomes one is the accounts desk's call — see `gstTreatment`. That is the
/// whole reason the two are separate columns.
enum PurchaseAdjustmentDoc {
  /// Our own commercial debit note or claim on the supplier.
  OUR_DEBIT_NOTE
  /// Their document, reducing the value of their own invoice.
  SUPPLIER_CREDIT_NOTE
  /// Their document, increasing the value of their own invoice.
  SUPPLIER_DEBIT_NOTE
  /// Anything the accounts desk configures that is none of the above.
  OTHER
}

/// How the accounts desk has classified this for GST — and nobody else.
///
/// A purchase clerk records that twelve rolls came back damaged. Whether that
/// becomes a section 34 credit note, an ITC reversal, or stays a purely
/// commercial claim with no GST consequence at all is a question about the
/// supplier's filing, the month, and whether they ever issued a document. The
/// purchase office cannot answer it and must not be asked to, so this column
/// starts at NOT_REVIEWED and only an accounts hand may move it.
enum PurchaseGstTreatment {
  /// The default. Accounts has not looked at this yet.
  NOT_REVIEWED
  /// Supplier issued a credit note under s.34(1); our ITC reduces.
  GST_CREDIT_NOTE
  /// Supplier issued a debit note under s.34(3); further ITC is available.
  GST_DEBIT_NOTE
  /// No supplier document — we reverse the input credit ourselves.
  ITC_REVERSAL_ONLY
  /// Commercial only. The invoice and the input credit both stand.
  NO_GST_IMPACT
}

/// What happened, in the words the purchase office already uses.
///
/// This is a description of an event in the godown or on the bill. It is NOT
/// a document type and NOT an accounting position, and nothing here may be
/// read as implying either: the same damaged lot can end up as our claim, as
/// their credit note, or as neither, depending on what the supplier does next.
///
/// `EXCESS_QUANTITY_BILLED` was dropped as a duplicate — "the bill shows more
/// than the challan" and SHORT_QUANTITY's "billed for more than arrived" are
/// one event written twice, and offering both only split the reporting.
enum PurchaseNoteReason {
  PURCHASE_RETURN
  SHORT_QUANTITY
  DAMAGED_MATERIAL
  QUALITY_REJECTION
  WRONG_MATERIAL
  WRONG_RATE
  EXCESS_BILLING
  POST_PURCHASE_DISCOUNT
  OTHER
}

/// What the adjustment does to the money owed.
///
/// Decided by the DOCUMENT, never by the reason. Damaged goods reduce the bill
/// when we claim for them and when the supplier credits them; the identical
/// damaged goods increase it if the supplier's answer is a debit note for the
/// replacement they sent. The event does not carry a direction — only the
/// document does.
enum PurchaseNoteEffect {
  REDUCES_PAYABLE
  INCREASES_PAYABLE
}

/// Draft → Submitted → Approved → Posted, with two ways out.
///
/// Its own enum rather than `NoteStatus`, which the sales credit note still
/// wears. Saving is not issuing and issuing is not posting: a note moves the
/// payable at POSTED and at no earlier step, which is a separate press by the
/// accounts desk.
enum PurchaseNoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

/// An adjustment to what a supplier is owed, raised after their bill was
/// booked.
///
/// One table for every kind. Our commercial claim, the supplier's credit note
/// and the supplier's debit note carry the same fields, point at the same
/// bill, validate against the same remaining balance and print on the same
/// sheet. What differs between them is who issued it, which way the money
/// goes and how GST sees it — three columns, not three tables.
///
/// The bill it adjusts is never edited. `PurchaseInvoice.noteAdjustment` is a
/// roll-up recomputed from the posted notes, so the invoice's own lines and
/// totals stand exactly as the supplier sent them, however many adjustments
/// accumulate against it.
model PurchaseNote {
  id         String             @id @default(cuid())
  /// Ours, always. A supplier's credit note is filed under our own reference
  /// so it can be found; their number is `supplierDocNo`.
  noteNumber String             @unique
  status     PurchaseNoteStatus @default(DRAFT)

  // ── The three facts, kept apart ────────────────────────────────────────
  //
  // One column used to carry all three and could therefore express only two
  // of the eight combinations that occur. They are separate because they are
  // answered by different people from different evidence: the godown says
  // what happened, the post says who issued what, and the accounts desk says
  // what it means for GST.

  /// What happened. A description of an event, carrying no direction.
  reason     PurchaseNoteReason
  /// Required when the reason is OTHER; a free remark otherwise.
  reasonNote String?

  /// Who raised it. Ours or theirs.
  issuedBy PurchaseAdjustmentIssuer @default(OUR_COMPANY)
  /// What kind of document resulted.
  docType  PurchaseAdjustmentDoc    @default(OUR_DEBIT_NOTE)

  /// Which way the money moves. Follows `docType`, never `reason`.
  effect PurchaseNoteEffect

  /// The accounts desk's classification. Purchase cannot set it; posting is
  /// refused until somebody with the accounts permission has.
  gstTreatment   PurchaseGstTreatment @default(NOT_REVIEWED)
  gstNote        String?
  gstTreatedById String?
  gstTreatedBy   User?                @relation("NoteGstTreatedBy", fields: [gstTreatedById], references: [id])
  gstTreatedAt   DateTime?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// The bill being adjusted. Optional only for the authorised case of an
  /// adjustment with no invoice behind it — which is recorded as a decision,
  /// not assumed: see `withoutBillReason`.
  billId            String?
  bill              PurchaseInvoice? @relation(fields: [billId], references: [id], onDelete: Restrict)
  /// Why this note has no bill behind it. Present exactly when `billId` is
  /// null, so an unlinked note can never look like an oversight.
  withoutBillReason String?

  /// Carried for the trail, never for the arithmetic — the bill is what a
  /// note adjusts. Settable by hand for a note raised off a delivery the
  /// supplier has not billed yet.
  poId  String?
  po    PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Restrict)
  grnId String?
  grn   GRN?           @relation(fields: [grnId], references: [id], onDelete: Restrict)

  noteDate DateTime @default(now())

  /// The return challan this note was raised from, when the goods physically
  /// went back. Set only by the challan itself, never by the note form.
  ///
  /// A note carrying one never moves stock: the challan already took the goods
  /// off the rack at the gate, and posting the note is the money side of the
  /// same event, not a second trip. `Restrict` because a challan with the note
  /// it produced deleted from under it would leave goods gone and nothing
  /// claimed for them.
  returnId       String?
  purchaseReturn PurchaseReturn? @relation(fields: [returnId], references: [id], onDelete: Restrict)

  /// The supplier's own document, when they are the one who wrote it. Their
  /// number and their date, kept as they printed them.
  supplierDocNo   String?
  supplierDocDate DateTime?

  /// Where the goods sat, which is where a return takes them out of. Only a
  /// note that actually moves goods needs one.
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// The paperwork that travels with returned goods.
  lrNumber  String?
  vehicleNo String?
  otherRef  String?

  /// Frozen when the note is raised. A supplier whose state is corrected next
  /// month must not silently re-split the tax on a note already posted.
  isIntraState Boolean @default(true)

  taxableAmount  Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  cgst           Decimal @default(0) @db.Decimal(12, 2)
  sgst           Decimal @default(0) @db.Decimal(12, 2)
  igst           Decimal @default(0) @db.Decimal(12, 2)
  otherCharges   Decimal @default(0) @db.Decimal(12, 2)
  roundOff       Decimal @default(0) @db.Decimal(6, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  createdById String
  createdBy   User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Who moved it, and when. Separate columns rather than one audit blob,
  /// because docs/04-business-rules.md forbids the person who raised a
  /// document from approving it, and that rule cannot be enforced against a
  /// single name.
  submittedById String?
  submittedBy   User?     @relation("NoteSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  approvedById  String?
  approvedBy    User?     @relation("NoteApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  postedById    String?
  postedBy      User?     @relation("NotePostedBy", fields: [postedById], references: [id])
  postedAt      DateTime?
  closedById    String?
  closedBy      User?     @relation("NoteClosedBy", fields: [closedById], references: [id])
  closedAt      DateTime?
  /// Why it was rejected or cancelled. A document that stops moving has to say
  /// what stopped it.
  closedReason  String?

  lines       PurchaseNoteLine[]
  attachments PurchaseNoteAttachment[]

  /// A supplier's own document booked twice claims the same adjustment twice,
  /// which is the mistake the duplicate-bill guard exists for. Postgres treats
  /// NULLs as distinct, so our own commercial claims — which carry no supplier
  /// document number — are unaffected.
  @@unique([supplierId, supplierDocNo])
  @@index([supplierId])
  @@index([billId])
  @@index([docType, status])
  @@index([issuedBy, status])
  @@index([returnId])
  @@map("purchase_notes")
}

/// Whether a return challan still stands.
///
/// No draft: a challan is written at the gate as the vehicle is loaded, and the
/// goods leave the moment it is saved. Cancelling puts them back — possible
/// only while the debit note it produced is still a draft, because once that
/// note is posted the supplier's account has been charged for the return.
enum PurchaseReturnStatus {
  DISPATCHED
  CANCELLED
}

/// A purchase return challan — the outward gate pass for goods going back to a
/// supplier.
///
/// The physical half of a return. The debit note is the financial half, and
/// they are separate documents because they are signed by different people at
/// different times: the godown loads the vehicle and the security gate lets it
/// out against this, and accounts decides days later what the return is worth
/// and posts the note. Before this existed a debit note did both, which meant
/// goods could leave with no gate pass at all, or a gate pass could exist only
/// once accounts had got round to it.
///
/// The chain is Purchase Bill → Return Challan → Debit Note. Every challan is
/// raised against a bill, and saving one writes a draft note linked back to it.
model PurchaseReturn {
  id           String               @id @default(cuid())
  /// PRC-0001 upward. One running series, like the rest of the purchase chain.
  returnNumber String               @unique
  status       PurchaseReturnStatus @default(DISPATCHED)
  returnDate   DateTime             @default(now())

  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  billId     String
  bill       PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Restrict)

  /// Why the goods are going back. Only the reasons where material moves.
  reason     PurchaseNoteReason
  reasonNote String?

  /// How they are going. What the security gate checks and what an e-way bill
  /// is raised against.
  vehicleNo       String?
  transporterName String?
  lrNumber        String?
  ewayBillNo      String?
  driverName      String?

  remarks String?

  createdById   String
  createdBy     User      @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cancelledById String?
  cancelledBy   User?     @relation("ReturnCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  lines      PurchaseReturnLine[]
  debitNotes PurchaseNote[]

  @@index([supplierId])
  @@index([billId])
  @@index([status, returnDate])
  @@map("purchase_returns")
}

/// One item going back, from one godown, against one bill line.
model PurchaseReturnLine {
  id             String         @id @default(cuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// The bill line the goods were charged on. Required: a return with nothing
  /// to be returned against cannot be valued, and cannot be checked against
  /// what was bought.
  billLineId String
  billLine   PurchaseInvoiceLine @relation(fields: [billLineId], references: [id], onDelete: Restrict)

  /// The godown it leaves from — per line, because one delivery is routinely
  /// split across two stores and the goods go back from wherever they are.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  qty       Decimal @db.Decimal(10, 3)
  /// The bill's own rate and GST, frozen here for the challan's declared value
  /// and carried onto the debit note it produces.
  unitPrice Decimal @db.Decimal(10, 2)
  gstRate   Decimal @default(0) @db.Decimal(5, 2)

  remarks   String?
  sortOrder Int     @default(0)

  @@index([returnId])
  @@index([billLineId])
  @@map("purchase_return_lines")
}

model PurchaseNoteLine {
  id     String       @id @default(cuid())
  noteId String
  note   PurchaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId String
  item   Item         @relation(fields: [itemId], references: [id])

  /// The bill line this adjusts, which is the whole basis of the balance
  /// check: what is left to adjust is that line's quantity less every note
  /// line already pointing at it. Without this a note can only be validated
  /// against the bill as a lump, and 100 metres of the wrong item passes so
  /// long as the total fits.
  ///
  /// `Restrict`, matching `PurchaseInvoiceLine.grnLineId` — a set-null here
  /// would leave a posted adjustment pointing at nothing, and the line it
  /// adjusted claimable all over again.
  billLineId String?
  billLine   PurchaseInvoiceLine? @relation(fields: [billLineId], references: [id], onDelete: Restrict)

  /// The receipt line this adjusts, on a note raised with no bill behind it.
  ///
  /// Goods rejected at the gate are never billed, so there is no bill line to
  /// point at — this is what "how much of this GRN line is still left to
  /// note" is worked out from instead, the same way `billLineId` answers that
  /// for a note that does have a bill. `Restrict`, matching `billLineId`: a
  /// receipt line deleted out from under a posted note would leave the note
  /// pointing at nothing and its quantity claimable all over again.
  grnLineId String?
  grnLine   GRNLine? @relation(fields: [grnLineId], references: [id], onDelete: Restrict)

  description String?
  hsnCode     String?

  /// What the bill said, snapshotted. Printed beside the adjustment so the
  /// reader sees 100 billed and 12 returned without opening the bill.
  originalQty  Decimal? @db.Decimal(10, 3)
  originalRate Decimal? @db.Decimal(10, 2)

  /// The adjustment itself — how much is coming off, at what rate.
  qty       Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)

  taxableValue Decimal @default(0) @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(12, 2)
  sgst         Decimal @default(0) @db.Decimal(12, 2)
  igst         Decimal @default(0) @db.Decimal(12, 2)
  amount       Decimal @default(0) @db.Decimal(12, 2)

  remarks   String?
  sortOrder Int     @default(0)

  @@index([noteId])
  @@index([billLineId])
  @@index([grnLineId])
  @@map("purchase_note_lines")
}

model PurchaseNoteAttachment {
  id           String       @id @default(cuid())
  noteId       String
  note         PurchaseNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileName     String
  storagePath  String       @unique
  mimeType     String?
  sizeBytes    Int
  uploadedById String
  uploadedBy   User         @relation("NoteAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([noteId])
  @@map("purchase_note_attachments")
}

// ═══════════════════════════════════════════
// AWAITING REMOVAL
// ═══════════════════════════════════════════

/// Superseded by `PurchaseNote`. Kept only until this work reaches `main`.
///
/// Nothing in the application reads or writes these two models any more. They
/// are still here because the API deployed from `main` does: its `billInclude`
/// joins `debit_notes` on every read of a purchase bill, so dropping the table
/// now would break the live bill list days before the branch that replaced it
/// is merged. Both tables are empty.
///
/// Delete these models and their three relation fields — `Supplier.debitNotes`,
/// `Item.debitLines`, `PurchaseInvoice.debitNotes` — in the same change that
/// merges, and let the migration drop the tables then.
model DebitNote {
  id          String           @id @default(cuid())
  noteNumber  String           @unique
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  billId      String?
  bill        PurchaseInvoice? @relation(fields: [billId], references: [id])
  noteDate    DateTime         @default(now())
  reason      String?
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  cgst        Decimal          @default(0) @db.Decimal(12, 2)
  sgst        Decimal          @default(0) @db.Decimal(12, 2)
  igst        Decimal          @default(0) @db.Decimal(12, 2)
  roundOff    Decimal          @default(0) @db.Decimal(6, 2)
  totalAmount Decimal          @default(0) @db.Decimal(12, 2)
  status      NoteStatus       @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lines DebitNoteLine[]

  @@index([supplierId])
  @@map("debit_notes")
}

/// Superseded by `PurchaseNoteLine`. See `DebitNote`.
model DebitNoteLine {
  id           String    @id @default(cuid())
  noteId       String
  note         DebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  description  String?
  hsnCode      String?
  qty          Decimal   @db.Decimal(10, 3)
  unitPrice    Decimal   @db.Decimal(10, 2)
  taxableValue Decimal   @default(0) @db.Decimal(12, 2)
  gstRate      Decimal   @default(0) @db.Decimal(5, 2)
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder    Int       @default(0)

  @@map("debit_note_lines")
}

// ═══════════════════════════════════════════
// PRINTED DOCUMENTS
// ═══════════════════════════════════════════

/// What appears on one kind of printed document.
///
/// Deliberately not a layout editor. The arrangement of an Indian tax invoice
/// is fixed by what the law requires on it, so there is nothing useful to drag
/// around. What genuinely varies between businesses is the wording and which
/// optional blocks are shown, and that is all this holds.
model DocumentTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// INV, PO, DC, JW — matches the document numbering series.
  docType String
  /// Printed as the heading, e.g. "TAX INVOICE" or "DELIVERY CHALLAN".
  title   String

  /// Long-form terms printed at the foot.
  termsText   String?
  /// The line an Indian invoice normally carries certifying the particulars.
  declaration String?
  /// A short line under everything else, such as jurisdiction.
  footerNote  String?

  showHsn           Boolean  @default(true)
  showAmountInWords Boolean  @default(true)
  showBankDetails   Boolean  @default(true)
  showSignature     Boolean  @default(true)
  /// Copy labels printed one per page, e.g. Original for Recipient.
  copies            String[]

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([companyId, docType])
  @@map("document_templates")
}
