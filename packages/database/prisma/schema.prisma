// LD ERP Solution — Complete Prisma Database Schema
// Version: 1.0.0 | PostgreSQL 16 | Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) — used by the running app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — pgbouncer cannot run DDL, so migrations need this.
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BrandType {
  LD_COTTON_MILLS
  VHAGAR
  CUSTOM
}

enum ItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  CONSUMABLE
  PACKING_MATERIAL
  TRIM
}

enum CustomerType {
  DOMESTIC
  EXPORT
  JOB_WORK
  VHAGAR_DEALER
}

enum SupplierCategory {
  FABRIC
  THREAD
  BUTTON
  LINING
  LABEL
  PACKAGING
  TRIM
  TRANSPORT
  SERVICE
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum MOStatus {
  DRAFT
  RELEASED
  CUTTING
  STITCHING
  FINISHING
  QC
  PACKING
  COMPLETED
  CLOSED
}

/// Why a quantity moved. This is the label a store keeper reads on the ledger,
/// so each one has to mean exactly one thing. ISSUE and PRODUCTION are separate
/// from ADJUSTMENT on purpose: material going out to the floor and finished
/// pieces coming back are normal daily traffic, while an adjustment means the
/// book was wrong and somebody corrected it. Folding them together would hide
/// the one movement that always deserves a second look.
enum TransactionType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  OPENING
  ISSUE
  PRODUCTION
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

/// Whether a supplier payment still settles anything.
enum PaymentStatus {
  POSTED
  REVERSED
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  PDC
}

enum EmploymentType {
  PERMANENT
  DAILY_WAGE
  CONTRACT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QCResult {
  PASS
  FAIL
  CONDITIONAL_PASS
}

/// Sales and purchase invoices share one payment lifecycle.
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum ChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum GRNStatus {
  DRAFT
  QC_PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CuttingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PackingStatus {
  IN_PROGRESS
  COMPLETED
  DISPATCHED
}

enum MachineStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BREAKDOWN
  RETIRED
}

enum BreakdownStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum MaintenanceStatus {
  PENDING
  DONE
  OVERDUE
  SKIPPED
}

/// A workstation is either our own floor or an outside job-work unit we pay.
enum WorkstationType {
  IN_HOUSE
  JOB_WORK
}

/// Fabric sent in by a customer for job work is in our godown but is not ours.
/// Counting it as stock would inflate the stock value and the balance sheet.
enum StockOwnership {
  OWNED
  CUSTOMER_OWNED
}

enum NoteStatus {
  DRAFT
  ISSUED
  ADJUSTED
  CANCELLED
}

// ═══════════════════════════════════════════
// AUTH & RBAC
// ═══════════════════════════════════════════

model User {
  id           String     @id @default(cuid())
  employeeCode String?    @unique
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs            AuditLog[]
  notifications        Notification[]
  aiConversations      AIConversation[]
  createdSOs           SalesOrder[]                @relation("SOCreatedBy")
  approvedSOs          SalesOrder[]                @relation("SOApprovedBy")
  createdEnquiries     PurchaseEnquiry[]           @relation("EnquiryCreatedBy")
  createdPOs           PurchaseOrder[]             @relation("POCreatedBy")
  approvedPOs          PurchaseOrder[]             @relation("POApprovedBy")
  createdMOs           ManufacturingOrder[]        @relation("MOCreatedBy")
  raisedMRs            MaterialRequisition[]       @relation("MRRaisedBy")
  approvedMRs          MaterialRequisition[]       @relation("MRApprovedBy")
  issuedMRs            MaterialRequisition[]       @relation("MRIssuedBy")
  createdBills         PurchaseInvoice[]           @relation("BillCreatedBy")
  createdPayments      SupplierPayment[]           @relation("PaymentCreatedBy")
  reversedPayments     SupplierPayment[]           @relation("PaymentReversedBy")
  uploadedFiles        PurchaseOrderAttachment[]   @relation("AttachmentUploadedBy")
  uploadedEnquiryFiles PurchaseEnquiryAttachment[] @relation("EnquiryAttachmentUploadedBy")
  movedStock           StockTransfer[]             @relation("TransferMovedBy")
  cancelledStock       StockTransfer[]             @relation("TransferCancelledBy")
  countedStock         StockAdjustment[]           @relation("AdjustmentMadeBy")
  receivedGoods        GRN[]                       @relation("GRNCreatedBy")
  uploadedGrnFiles     GRNAttachment[]             @relation("GRNAttachmentUploadedBy")
  uploadedPaymentFiles SupplierPaymentAttachment[] @relation("PaymentAttachmentUploadedBy")
  shortClosedPoLines   PurchaseOrderLine[]         @relation("PurchaseOrderLineShortClosedBy")
  createdNotes         PurchaseNote[]              @relation("NoteCreatedBy")
  submittedNotes       PurchaseNote[]              @relation("NoteSubmittedBy")
  approvedNotes        PurchaseNote[]              @relation("NoteApprovedBy")
  postedNotes          PurchaseNote[]              @relation("NotePostedBy")
  closedNotes          PurchaseNote[]              @relation("NoteClosedBy")
  gstTreatedNotes      PurchaseNote[]              @relation("NoteGstTreatedBy")
  createdReturns       PurchaseReturn[]            @relation("ReturnCreatedBy")
  cancelledReturns     PurchaseReturn[]            @relation("ReturnCancelledBy")
  uploadedNoteFiles    PurchaseNoteAttachment[]    @relation("NoteAttachmentUploadedBy")

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  module String
  action String

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  module     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// COMPANY & MASTERS
// ═══════════════════════════════════════════

model Company {
  id             String    @id @default(cuid())
  name           String
  legalName      String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?   @unique
  /// Two-digit GST state code, e.g. "27" for Maharashtra. Place of supply is
  /// decided by comparing this against the customer's, so it cannot be free text.
  stateCode      String?
  pan            String?
  /// Needed on every TDS challan and to issue Form 16A to contractors.
  tan            String?
  /// Udyam registration. Drives the 45-day payment rule for MSME suppliers.
  msmeNumber     String?
  phone          String?
  email          String?
  website        String?
  /// Printed at the top of every document. Stored inline so a mill PC with no
  /// file server still prints a letterhead.
  logoUrl        String?
  /// Printed above the signature line.
  signatureUrl   String?
  /// The account a customer is asked to pay into, printed on the invoice.
  bankName       String?
  bankBranch     String?
  bankAccount    String?
  bankIFSC       String?
  upiId          String?
  currentFY      String?
  fyStartMonth   Int       @default(4)
  /// Nothing may be dated before the books open.
  booksStartDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brands       Brand[]
  warehouses   Warehouse[]
  departments  Department[]
  numberSeries NumberSeries[]
  taxRates     TaxRate[]
  tdsSections  TdsSection[]
  settings     AppSetting[]
  documents    DocumentTemplate[]

  @@map("company")
}

model Brand {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  type        BrandType
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  salesOrders         SalesOrder[]
  manufacturingOrders ManufacturingOrder[]

  @@map("brands")
}

model NumberSeries {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  docType       String
  prefix        String
  separator     String  @default("-")
  financialYear String
  lastNumber    Int     @default(0)
  padding       Int     @default(4)
  isActive      Boolean @default(true)

  @@unique([companyId, docType, financialYear])
  @@map("number_series")
}

/// GST rates the business actually charges, so the sales screens can offer a
/// short list instead of a free-typed percentage nobody can reconcile later.
model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([companyId, name])
  @@map("tax_rates")
}

model TdsSection {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section   String // e.g. "194C"
  label     String // e.g. "Contractor payments — Individual/HUF"
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, section, label])
  @@map("tds_sections")
}

/// One row per preference. A key/value table rather than columns, so adding a
/// preference never needs a migration — the catalogue of valid keys lives in
/// the API, which is also what stops arbitrary keys being written.
model AppSetting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("app_settings")
}

model ItemCategory {
  id       String         @id @default(cuid())
  name     String         @unique
  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  isActive Boolean        @default(true)

  items Item[]

  @@map("item_categories")
}

model UOM {
  id       String  @id @default(cuid())
  name     String  @unique
  symbol   String  @unique
  isActive Boolean @default(true)

  items        Item[]
  challanLines DeliveryChallanLine[]

  @@map("uom")
}

model Item {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  type         ItemType
  categoryId   String
  category     ItemCategory @relation(fields: [categoryId], references: [id])
  uomId        String
  uom          UOM          @relation(fields: [uomId], references: [id])
  hsnCode      String?
  reorderLevel Decimal?     @db.Decimal(10, 3)
  minStock     Decimal?     @db.Decimal(10, 3)
  maxStock     Decimal?     @db.Decimal(10, 3)
  standardRate Decimal?     @db.Decimal(10, 2)
  /// The rate that appears by itself on a document line. Absolute leaves this
  /// to memory on every line, which is how one ledger ends up with three rates
  /// for the same cloth.
  taxRateId    String?
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id])
  imageUrl     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bomComponents BOMLine[]                 @relation("ComponentItem")
  stockLedger   StockLedger[]
  enquiryLines  PurchaseEnquiryLine[]
  poLines       PurchaseOrderLine[]
  soLines       SalesOrderLine[]
  mrLines       MaterialRequisitionLine[]
  grnLines      GRNLine[]
  transferLines StockTransferLine[]
  countLines    StockAdjustmentLine[]
  invoiceLines  SalesInvoiceLine[]
  billLines     PurchaseInvoiceLine[]
  creditLines   CreditNoteLine[]
  noteLines     PurchaseNoteLine[]
  returnLines   PurchaseReturnLine[]
  debitLines    DebitNoteLine[]

  @@index([code])
  @@index([type])
  @@map("items")
}

model Style {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  season      String?
  brandType   BrandType
  category    String?
  collarType  String?
  sleeveType  String?
  fit         String?
  fabricType  String?
  gsm         Int?
  /// The size run this style is made in. Replaces a free-text array that let
  /// "XL" and "xl" exist side by side and silently stop reconciling.
  sizeGroupId String?
  sizeGroup   SizeGroup? @relation(fields: [sizeGroupId], references: [id])
  colors      String[]
  techPackUrl String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  boms     BOM[]
  moLines  MOLine[]
  routings Routing[]
  poLines  PurchaseOrderLine[]

  @@index([code])
  @@map("styles")
}

model BOM {
  id        String   @id @default(cuid())
  styleId   String
  style     Style    @relation(fields: [styleId], references: [id])
  version   String   @default("1.0")
  isActive  Boolean  @default(true)
  totalCost Decimal? @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BOMLine[]

  @@unique([styleId, version])
  @@map("bom")
}

model BOMLine {
  id              String   @id @default(cuid())
  bomId           String
  bom             BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItemId String
  componentItem   Item     @relation("ComponentItem", fields: [componentItemId], references: [id])
  qtyPerUnit      Decimal  @db.Decimal(10, 4)
  wastagePercent  Decimal  @default(0) @db.Decimal(5, 2)
  effectiveQty    Decimal  @db.Decimal(10, 4)
  unitCost        Decimal? @db.Decimal(10, 4)
  totalCost       Decimal? @db.Decimal(10, 4)
  notes           String?
  sortOrder       Int      @default(0)

  @@map("bom_lines")
}

model Customer {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  type              CustomerType
  gstin             String?
  pan               String?
  phone             String?
  email             String?
  billingAddress    String?
  billingCity       String?
  billingState      String?
  /// Two-digit GST state code. This, not the state name, decides CGST+SGST vs IGST.
  billingStateCode  String?
  billingPincode    String?
  shippingAddress   String?
  shippingCity      String?
  shippingState     String?
  shippingStateCode String?
  shippingPincode   String?
  /// A buyer can take delivery in one state under a GSTIN registered in another.
  shippingGstin     String?
  creditLimit       Decimal?     @db.Decimal(12, 2)
  creditDays        Int          @default(30)
  paymentTerms      String?
  bankName          String?
  bankAccount       String?
  bankIFSC          String?
  /// The agent who brings this buyer, and what they are paid on the sale.
  brokerId          String?
  broker            Broker?      @relation(fields: [brokerId], references: [id])
  brokeragePercent  Decimal?     @db.Decimal(5, 2)
  /// Another company under the same owners — LD Silk Mills, for instance.
  /// Trades at arm's length with its own GSTIN, but is flagged so intercompany
  /// turnover can be identified and excluded from group figures.
  isGroupCompany    Boolean      @default(false)
  isActive          Boolean      @default(true)
  isBlacklisted     Boolean      @default(false)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  salesOrders  SalesOrder[]
  /// Purchase orders the supplier was told to deliver straight to this customer.
  poDeliveries PurchaseOrder[]  @relation("PODeliveryCustomer")
  invoices     SalesInvoice[]
  payments     PaymentReceipt[]
  creditNotes  CreditNote[]
  ownedStock   StockLedger[]    @relation("CustomerOwnedStock")

  @@index([code])
  @@map("customers")
}

/// One of the places a supplier bills from.
///
/// A supplier can have more than one: a head office and a works, or a second
/// registration in another state. The supplier master held exactly one address
/// before this, so the second one went into a remark and never reconciled
/// against anything.
///
/// `stateCode` sits on the address and not only on the supplier because it is
/// what decides the tax split — a second address in another state changes what
/// that supplier may charge on an order billed from there. Same reason `gstin`
/// is here: a business registers per place of business.
model SupplierAddress {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// What the mill calls it — "Head office", "Bhiwandi works". Optional,
  /// because most suppliers have one place and naming it is busywork.
  label      String?
  address    String
  city       String?
  state      String?
  /// Two-digit GST state code.
  stateCode  String?
  pincode    String?
  country    String?  @default("India")
  gstin      String?
  /// The one a new order is offered first.
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_addresses")
}

model Supplier {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  category       SupplierCategory
  gstin          String?
  pan            String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  /// Two-digit GST state code — decides the tax split on a purchase.
  stateCode      String?
  pincode        String?
  creditDays     Int              @default(30)
  leadTimeDays   Int              @default(7)
  paymentTerms   String?
  bankName       String?
  bankAccount    String?
  bankIFSC       String?
  rating         Int?             @db.SmallInt
  isPreferred    Boolean          @default(false)
  /// Registered under MSME/Udyam — payment falls due within 45 days by law.
  isMsme         Boolean          @default(false)
  msmeNumber     String?
  /// Another company under the same owners, trading at arm's length under its
  /// own GSTIN. LD Silk Mills supplies fabric to LD Cotton Mills this way, so
  /// the purchase is real and carries GST, but group figures must exclude it.
  isGroupCompany Boolean          @default(false)
  isActive       Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  addresses       SupplierAddress[]
  enquiryQuotes   PurchaseEnquiryQuote[]
  purchaseOrders  PurchaseOrder[]
  invoices        PurchaseInvoice[]
  payments        SupplierPayment[]
  purchaseNotes   PurchaseNote[]
  purchaseReturns PurchaseReturn[]
  debitNotes      DebitNote[]
  workstations    Workstation[]

  @@index([code])
  @@map("suppliers")
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String  @unique
  address   String?
  isActive  Boolean @default(true)

  stockLedger       StockLedger[]
  mrLines           MaterialRequisitionLine[]
  grnLines          GRNLine[]
  /// Enquiries that name this store as where the goods are wanted.
  purchaseEnquiries PurchaseEnquiry[]         @relation("EnquiryLocation")
  purchaseOrders    PurchaseOrder[]
  transfersOut      StockTransfer[]           @relation("TransferFrom")
  transfersIn       StockTransfer[]           @relation("TransferTo")
  adjustments       StockAdjustment[]

  supplierPayments SupplierPayment[]
  purchaseNotes    PurchaseNote[]
  returnLines      PurchaseReturnLine[]

  @@map("warehouses")
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String  @unique
  isActive  Boolean @default(true)

  operations        Operation[]
  employees         Employee[]
  machines          Machine[]
  workstations      Workstation[]
  requisitions      MaterialRequisition[]
  productionEntries ProductionEntry[]
  routingSteps      RoutingStep[]

  @@map("departments")
}

model Operation {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  code         String     @unique
  /// Standard minute value — how long one piece of this operation should take.
  smv          Decimal?   @db.Decimal(5, 3)
  /// What an outside unit is paid per piece for this operation.
  jobWorkRate  Decimal?   @db.Decimal(10, 2)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)

  routingSteps      RoutingStep[]
  productionEntries ProductionEntry[]

  @@map("operations")
}

model Machine {
  id             String        @id @default(cuid())
  machineNo      String        @unique
  name           String
  type           String
  brand          String?
  model          String?
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id])
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  amcStart       DateTime?
  amcEnd         DateTime?
  status         MachineStatus @default(OPERATIONAL)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  breakdowns   MachineBreakdown[]
  maintenances MaintenanceSchedule[]

  @@map("machines")
}

// ═══════════════════════════════════════════
// SALES
// ═══════════════════════════════════════════

model SalesOrder {
  id                String           @id @default(cuid())
  soNumber          String           @unique
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id])
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  customerPORef     String?
  customerPODate    DateTime?
  orderDate         DateTime         @default(now())
  deliveryDate      DateTime?
  deliveryAddress   String?
  salesperson       String?
  /// The agent on this sale and what they earn. Brokerage is a real cost with
  /// TDS deducted against it, so it cannot live only in someone's notebook.
  brokerId          String?
  broker            Broker?          @relation(fields: [brokerId], references: [id])
  brokeragePercent  Decimal?         @db.Decimal(5, 2)
  brokerageAmount   Decimal          @default(0) @db.Decimal(12, 2)
  /// Two-digit GST state code of the delivery. Compared against the company's
  /// to decide CGST+SGST or IGST — and it is compulsory on a tax invoice.
  placeOfSupplyCode String?
  status            SalesOrderStatus @default(DRAFT)
  subtotal          Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal          @default(0) @db.Decimal(12, 2)
  cgst              Decimal          @default(0) @db.Decimal(12, 2)
  sgst              Decimal          @default(0) @db.Decimal(12, 2)
  igst              Decimal          @default(0) @db.Decimal(12, 2)
  roundOff          Decimal          @default(0) @db.Decimal(6, 2)
  totalAmount       Decimal          @default(0) @db.Decimal(12, 2)
  currency          String           @default("INR")
  isJobWork         Boolean          @default(false)
  notes             String?
  attachmentUrl     String?
  version           Int              @default(1)
  createdById       String
  createdBy         User             @relation("SOCreatedBy", fields: [createdById], references: [id])
  approvedById      String?
  approvedBy        User?            @relation("SOApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines               SalesOrderLine[]
  deliveryChallans    DeliveryChallan[]
  invoices            SalesInvoice[]
  manufacturingOrders ManufacturingOrder[]

  @@index([soNumber])
  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  soId         String
  so           SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])
  styleCode    String?
  color        String?
  totalQty     Decimal    @db.Decimal(10, 2)
  unitPrice    Decimal    @default(0) @db.Decimal(10, 2)
  discount     Decimal    @default(0) @db.Decimal(5, 2)
  gstRate      Decimal    @default(0) @db.Decimal(5, 2)
  amount       Decimal    @default(0) @db.Decimal(12, 2)
  deliveredQty Decimal    @default(0) @db.Decimal(10, 2)
  pendingQty   Decimal    @default(0) @db.Decimal(10, 2)
  sortOrder    Int        @default(0)

  /// The size run. Rows rather than a JSON blob, so "XL" and "xl" cannot both
  /// exist and the quantities still reconcile at the invoice.
  sizes SalesOrderLineSize[]

  @@map("sales_order_lines")
}

model SalesInvoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  soId              String?
  so                SalesOrder?   @relation(fields: [soId], references: [id])
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime?
  /// Two-digit GST state code of the delivery — compulsory on a tax invoice.
  placeOfSupplyCode String?
  brokerId          String?
  broker            Broker?       @relation(fields: [brokerId], references: [id])
  brokeragePercent  Decimal?      @db.Decimal(5, 2)
  brokerageAmount   Decimal       @default(0) @db.Decimal(12, 2)
  subtotal          Decimal       @db.Decimal(12, 2)
  /// A discount given on the whole bill rather than line by line, which is how
  /// LD actually prices. Without it the invoice total cannot be reproduced.
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount     Decimal       @default(0) @db.Decimal(12, 2)
  cgst              Decimal       @default(0) @db.Decimal(12, 2)
  sgst              Decimal       @default(0) @db.Decimal(12, 2)
  igst              Decimal       @default(0) @db.Decimal(12, 2)
  /// Rounds the bill to the nearest rupee. Without it every total carries paise
  /// and nothing ties out against the customer's ledger.
  roundOff          Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount     Decimal       @db.Decimal(12, 2)
  status            InvoiceStatus @default(UNPAID)
  irnNumber         String?
  qrCodeData        String?
  ackNumber         String?
  ackDate           DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments    PaymentReceipt[]
  lines       SalesInvoiceLine[]
  charges     SalesInvoiceCharge[]
  creditNotes CreditNote[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@map("sales_invoices")
}

model DeliveryChallan {
  id             String        @id @default(cuid())
  dcNumber       String        @unique
  soId           String
  so             SalesOrder    @relation(fields: [soId], references: [id])
  dcDate         DateTime      @default(now())
  isReturnable   Boolean       @default(false)
  vehicleNumber  String?
