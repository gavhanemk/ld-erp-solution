// LD ERP Solution — Complete Prisma Database Schema
// Version: 1.0.0 | PostgreSQL 16 | Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) — used by the running app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — pgbouncer cannot run DDL, so migrations need this.
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BrandType {
  LD_COTTON_MILLS
  VHAGAR
  CUSTOM
}

enum ItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  CONSUMABLE
  PACKING_MATERIAL
  TRIM
}

enum CustomerType {
  DOMESTIC
  EXPORT
  JOB_WORK
  VHAGAR_DEALER
}

enum SupplierCategory {
  FABRIC
  THREAD
  BUTTON
  LINING
  LABEL
  PACKAGING
  TRIM
  TRANSPORT
  SERVICE
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_DISPATCHED
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum MOStatus {
  DRAFT
  RELEASED
  CUTTING
  STITCHING
  FINISHING
  QC
  PACKING
  COMPLETED
  CLOSED
}

/// Why a quantity moved. This is the label a store keeper reads on the ledger,
/// so each one has to mean exactly one thing. ISSUE and PRODUCTION are separate
/// from ADJUSTMENT on purpose: material going out to the floor and finished
/// pieces coming back are normal daily traffic, while an adjustment means the
/// book was wrong and somebody corrected it. Folding them together would hide
/// the one movement that always deserves a second look.
enum TransactionType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  OPENING
  ISSUE
  PRODUCTION
}

enum VoucherType {
  PAYMENT
  RECEIPT
  JOURNAL
  CONTRA
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  PDC
}

enum EmploymentType {
  PERMANENT
  DAILY_WAGE
  CONTRACT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QCResult {
  PASS
  FAIL
  CONDITIONAL_PASS
}

/// Sales and purchase invoices share one payment lifecycle.
enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum ChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  RETURNED
  CANCELLED
}

enum GRNStatus {
  DRAFT
  QC_PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CuttingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PackingStatus {
  IN_PROGRESS
  COMPLETED
  DISPATCHED
}

enum MachineStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  BREAKDOWN
  RETIRED
}

enum BreakdownStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum MaintenanceStatus {
  PENDING
  DONE
  OVERDUE
  SKIPPED
}

/// A workstation is either our own floor or an outside job-work unit we pay.
enum WorkstationType {
  IN_HOUSE
  JOB_WORK
}

/// Fabric sent in by a customer for job work is in our godown but is not ours.
/// Counting it as stock would inflate the stock value and the balance sheet.
enum StockOwnership {
  OWNED
  CUSTOMER_OWNED
}

enum NoteStatus {
  DRAFT
  ISSUED
  ADJUSTED
  CANCELLED
}

/// Where a bill of materials is in its life. A costing being typed and a
/// costing the cutting floor is working to are not the same document, and
/// until now nothing told them apart. Only one BOM per style is APPROVED at
/// a time, and that is the one an order is costed against.
enum BOMStatus {
  DRAFT
  APPROVED
  OBSOLETE
}

// ═══════════════════════════════════════════
// AUTH & RBAC
// ═══════════════════════════════════════════

model User {
  id           String     @id @default(cuid())
  employeeCode String?    @unique
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs       AuditLog[]
  notifications   Notification[]
  aiConversations AIConversation[]
  createdSOs      SalesOrder[]         @relation("SOCreatedBy")
  approvedSOs     SalesOrder[]         @relation("SOApprovedBy")
  createdPOs      PurchaseOrder[]      @relation("POCreatedBy")
  approvedPOs     PurchaseOrder[]      @relation("POApprovedBy")
  createdMOs      ManufacturingOrder[] @relation("MOCreatedBy")
  raisedMRs       MaterialRequisition[] @relation("MRRaisedBy")
  approvedMRs     MaterialRequisition[] @relation("MRApprovedBy")
  issuedMRs       MaterialRequisition[] @relation("MRIssuedBy")
  approvedBOMs    BOM[]                 @relation("BOMApprovedBy")

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  module String
  action String

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  module     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// COMPANY & MASTERS
// ═══════════════════════════════════════════

model Company {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  gstin        String?  @unique
  /// Two-digit GST state code, e.g. "27" for Maharashtra. Place of supply is
  /// decided by comparing this against the customer's, so it cannot be free text.
  stateCode    String?
  pan          String?
  /// Needed on every TDS challan and to issue Form 16A to contractors.
  tan          String?
  /// Udyam registration. Drives the 45-day payment rule for MSME suppliers.
  msmeNumber   String?
  phone        String?
  email        String?
  website      String?
  /// Printed at the top of every document. Stored inline so a mill PC with no
  /// file server still prints a letterhead.
  logoUrl      String?
  /// Printed above the signature line.
  signatureUrl String?
  /// The account a customer is asked to pay into, printed on the invoice.
  bankName     String?
  bankBranch   String?
  bankAccount  String?
  bankIFSC     String?
  upiId        String?
  currentFY    String?
  fyStartMonth Int      @default(4)
  /// Nothing may be dated before the books open.
  booksStartDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brands       Brand[]
  warehouses   Warehouse[]
  departments  Department[]
  numberSeries NumberSeries[]
  taxRates     TaxRate[]
  settings     AppSetting[]
  documents    DocumentTemplate[]

  @@map("company")
}

model Brand {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  name        String
  type        BrandType
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  salesOrders         SalesOrder[]
  manufacturingOrders ManufacturingOrder[]

  @@map("brands")
}

model NumberSeries {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  docType       String
  prefix        String
  separator     String  @default("-")
  financialYear String
  lastNumber    Int     @default(0)
  padding       Int     @default(4)
  isActive      Boolean @default(true)

  @@unique([companyId, docType, financialYear])
  @@map("number_series")
}

/// GST rates the business actually charges, so the sales screens can offer a
/// short list instead of a free-typed percentage nobody can reconcile later.
model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@unique([companyId, name])
  @@map("tax_rates")
}

/// One row per preference. A key/value table rather than columns, so adding a
/// preference never needs a migration — the catalogue of valid keys lives in
/// the API, which is also what stops arbitrary keys being written.
model AppSetting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@map("app_settings")
}

model ItemCategory {
  id       String         @id @default(cuid())
  name     String         @unique
  parentId String?
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  isActive Boolean        @default(true)

  items Item[]

  @@map("item_categories")
}

model UOM {
  id       String  @id @default(cuid())
  name     String  @unique
  symbol   String  @unique
  isActive Boolean @default(true)

  items        Item[]
  challanLines DeliveryChallanLine[]

  @@map("uom")
}

model Item {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  type         ItemType
  categoryId   String
  category     ItemCategory @relation(fields: [categoryId], references: [id])
  uomId        String
  uom          UOM          @relation(fields: [uomId], references: [id])
  hsnCode      String?
  reorderLevel Decimal?     @db.Decimal(10, 3)
  minStock     Decimal?     @db.Decimal(10, 3)
  maxStock     Decimal?     @db.Decimal(10, 3)
  standardRate Decimal?     @db.Decimal(10, 2)
  /// The rate that appears by itself on a document line. Absolute leaves this
  /// to memory on every line, which is how one ledger ends up with three rates
  /// for the same cloth.
  taxRateId    String?
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id])
  imageUrl     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bomComponents BOMLine[]                 @relation("ComponentItem")
  stockLedger   StockLedger[]
  poLines       PurchaseOrderLine[]
  soLines       SalesOrderLine[]
  mrLines       MaterialRequisitionLine[]
  grnLines      GRNLine[]
  invoiceLines  SalesInvoiceLine[]
  billLines     PurchaseInvoiceLine[]
  creditLines   CreditNoteLine[]
  debitLines    DebitNoteLine[]

  @@index([code])
  @@index([type])
  @@map("items")
}

model Style {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  season      String?
  brandType   BrandType
  category    String?
  collarType  String?
  sleeveType  String?
  fit         String?
  fabricType  String?
  gsm         Int?
  /// The size run this style is made in. Replaces a free-text array that let
  /// "XL" and "xl" exist side by side and silently stop reconciling.
  sizeGroupId String?
  sizeGroup   SizeGroup? @relation(fields: [sizeGroupId], references: [id])
  colors      String[]
  techPackUrl String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boms     BOM[]
  moLines  MOLine[]
  routings Routing[]

  @@index([code])
  @@map("styles")
}

model BOM {
  id           String    @id @default(cuid())
  styleId      String
  style        Style     @relation(fields: [styleId], references: [id])
  version      String    @default("1.0")
  /// The operations this garment goes through, for the labour half of its
  /// cost. It points at the routing rather than repeating the steps, so a rate
  /// is changed in one place and every BOM built on it moves with it.
  routingId    String?
  routing      Routing?  @relation(fields: [routingId], references: [id])
  /// The size the quantities on the lines are measured against. This used to
  /// live in the notes, as "size 40 basis", where nothing could read it and
  /// anyone opening a BOM somebody else built had to guess.
  baseSizeId   String?
  baseSize     Size?     @relation(fields: [baseSizeId], references: [id])
  /// Where this costing is in its life. Separate from isActive on purpose:
  /// isActive decides whether it is offered in a dropdown, status decides
  /// whether it may still be edited and whether orders are costed against it.
  status       BOMStatus @default(DRAFT)
  approvedById String?
  approvedBy   User?     @relation("BOMApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  /// Approving freezes a BOM, so a new version has to start from a copy.
  /// Otherwise the choice is re-typing twelve lines, and what happens instead
  /// is that somebody edits the approved one. This records what it came from.
  copiedFromId String?
  copiedFrom   BOM?      @relation("BOMCopy", fields: [copiedFromId], references: [id])
  isActive     Boolean   @default(true)
  /// Material only, for one garment at the base size. Deliberately not an
  /// average across the size run: an order is never an equal split of sizes,
  /// and the split lives on the order rather than here.
  totalCost    Decimal?  @db.Decimal(10, 2)
  /// The sum of rate per piece over the linked routing, kept beside the
  /// material cost so both halves of what a garment costs come from one row.
  labourCost   Decimal?  @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines  BOMLine[]
  copies BOM[]    @relation("BOMCopy")

  @@unique([styleId, version])
  @@index([status])
  @@map("bom")
}

model BOMLine {
  id              String   @id @default(cuid())
  bomId           String
  bom             BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItemId String
  componentItem   Item     @relation("ComponentItem", fields: [componentItemId], references: [id])
  /// Which part of the garment this goes into, such as "Body", "Collar" or
  /// "Cuff". The same self fabric legitimately appears twice on one BOM at two
  /// different wastages, because the parts are cut differently. Without this
  /// the second line reads as a typo, and it is why there is no unique
  /// constraint on bomId plus componentItemId.
  component       String?
  /// Consumption for one garment at the BOM base size. Sizes that differ carry
  /// their own row in BOMLineSize; every other size falls back to this.
  qtyPerUnit      Decimal  @db.Decimal(10, 4)
  wastagePercent  Decimal  @default(0) @db.Decimal(5, 2)
  effectiveQty    Decimal  @db.Decimal(10, 4)
  unitCost        Decimal? @db.Decimal(10, 4)
  totalCost       Decimal? @db.Decimal(10, 4)
  notes           String?
  sortOrder       Int      @default(0)

  sizes BOMLineSize[]

  @@index([bomId])
  @@index([componentItemId])
  @@map("bom_lines")
}

/// One size's own consumption, written only for the lines where it actually
/// differs. A 3XL shirt eats more cloth than an S, and a single figure for the
/// whole size run quietly over-orders the small end and under-orders the large.
/// Buttons, care labels and poly bags never vary, so most lines carry no rows
/// here at all and keep using the figure on the line above. That fallback is
/// what lets a style with no size run behave exactly as it did before.
model BOMLineSize {
  id           String   @id @default(cuid())
  bomLineId    String
  bomLine      BOMLine  @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  sizeId       String
  size         Size     @relation(fields: [sizeId], references: [id])
  qtyPerUnit   Decimal  @db.Decimal(10, 4)
  /// The line's wastage applied to this size's quantity, worked out on save so
  /// store and the costing sheet never do the multiplication differently.
  effectiveQty Decimal  @db.Decimal(10, 4)
  /// What one garment of this size costs in this component. The rate belongs to
  /// the item and does not change with size, so it is not repeated here.
  totalCost    Decimal? @db.Decimal(10, 4)

  @@unique([bomLineId, sizeId])
  @@map("bom_line_sizes")
}

model Customer {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  type            CustomerType
  gstin           String?
  pan             String?
  phone           String?
  email           String?
  billingAddress  String?
  billingCity     String?
  billingState    String?
  /// Two-digit GST state code. This, not the state name, decides CGST+SGST vs IGST.
  billingStateCode String?
  billingPincode  String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingStateCode String?
  shippingPincode String?
  /// A buyer can take delivery in one state under a GSTIN registered in another.
  shippingGstin   String?
  creditLimit     Decimal?     @db.Decimal(12, 2)
  creditDays      Int          @default(30)
  paymentTerms    String?
  bankName        String?
  bankAccount     String?
  bankIFSC        String?
  /// The agent who brings this buyer, and what they are paid on the sale.
  brokerId        String?
  broker          Broker?      @relation(fields: [brokerId], references: [id])
  brokeragePercent Decimal?    @db.Decimal(5, 2)
  /// Another company under the same owners — LD Silk Mills, for instance.
  /// Trades at arm's length with its own GSTIN, but is flagged so intercompany
  /// turnover can be identified and excluded from group figures.
  isGroupCompany  Boolean      @default(false)
  isActive        Boolean      @default(true)
  isBlacklisted   Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  salesOrders  SalesOrder[]
  invoices     SalesInvoice[]
  payments     PaymentReceipt[]
  creditNotes  CreditNote[]
  ownedStock   StockLedger[]  @relation("CustomerOwnedStock")

  @@index([code])
  @@map("customers")
}

model Supplier {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  category     SupplierCategory
  gstin        String?
  pan          String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  /// Two-digit GST state code — decides the tax split on a purchase.
  stateCode    String?
  pincode      String?
  creditDays   Int              @default(30)
  leadTimeDays Int              @default(7)
  paymentTerms String?
  bankName     String?
  bankAccount  String?
  bankIFSC     String?
  rating       Int?             @db.SmallInt
  isPreferred  Boolean          @default(false)
  /// Registered under MSME/Udyam — payment falls due within 45 days by law.
  isMsme       Boolean          @default(false)
  msmeNumber   String?
  /// Another company under the same owners, trading at arm's length under its
  /// own GSTIN. LD Silk Mills supplies fabric to LD Cotton Mills this way, so
  /// the purchase is real and carries GST, but group figures must exclude it.
  isGroupCompany Boolean        @default(false)
  isActive     Boolean          @default(true)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]
  payments       SupplierPayment[]
  debitNotes     DebitNote[]
  workstations   Workstation[]

  @@index([code])
  @@map("suppliers")
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String  @unique
  address   String?
  isActive  Boolean @default(true)

  stockLedger    StockLedger[]
  mrLines        MaterialRequisitionLine[]
  grnLines       GRNLine[]
  purchaseOrders PurchaseOrder[]

  @@map("warehouses")
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String  @unique
  isActive  Boolean @default(true)

  operations        Operation[]
  employees         Employee[]
  machines          Machine[]
  workstations      Workstation[]
  requisitions      MaterialRequisition[]
  productionEntries ProductionEntry[]
  routingSteps      RoutingStep[]

  @@map("departments")
}

model Operation {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  code         String     @unique
  /// Standard minute value — how long one piece of this operation should take.
  smv          Decimal?   @db.Decimal(5, 3)
  /// What an outside unit is paid per piece for this operation.
  jobWorkRate  Decimal?   @db.Decimal(10, 2)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)

  routingSteps     RoutingStep[]
  productionEntries ProductionEntry[]

  @@map("operations")
}

model Machine {
  id             String     @id @default(cuid())
  machineNo      String     @unique
  name           String
  type           String
  brand          String?
  model          String?
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  purchaseDate   DateTime?
  warrantyExpiry DateTime?
  amcStart       DateTime?
  amcEnd         DateTime?
  status         MachineStatus @default(OPERATIONAL)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  breakdowns   MachineBreakdown[]
  maintenances MaintenanceSchedule[]

  @@map("machines")
}

// ═══════════════════════════════════════════
// SALES
// ═══════════════════════════════════════════

model SalesOrder {
  id              String           @id @default(cuid())
  soNumber        String           @unique
  brandId         String
  brand           Brand            @relation(fields: [brandId], references: [id])
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  customerPORef   String?
  customerPODate  DateTime?
  orderDate       DateTime         @default(now())
  deliveryDate    DateTime?
  deliveryAddress String?
  salesperson     String?
  /// The agent on this sale and what they earn. Brokerage is a real cost with
  /// TDS deducted against it, so it cannot live only in someone's notebook.
  brokerId        String?
  broker          Broker?          @relation(fields: [brokerId], references: [id])
  brokeragePercent Decimal?        @db.Decimal(5, 2)
  brokerageAmount Decimal          @default(0) @db.Decimal(12, 2)
  /// Two-digit GST state code of the delivery. Compared against the company's
  /// to decide CGST+SGST or IGST — and it is compulsory on a tax invoice.
  placeOfSupplyCode String?
  status          SalesOrderStatus @default(DRAFT)
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal          @default(0) @db.Decimal(12, 2)
  cgst            Decimal          @default(0) @db.Decimal(12, 2)
  sgst            Decimal          @default(0) @db.Decimal(12, 2)
  igst            Decimal          @default(0) @db.Decimal(12, 2)
  roundOff        Decimal          @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2)
  currency        String           @default("INR")
  isJobWork       Boolean          @default(false)
  notes           String?
  attachmentUrl   String?
  version         Int              @default(1)
  createdById     String
  createdBy       User             @relation("SOCreatedBy", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?            @relation("SOApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines               SalesOrderLine[]
  deliveryChallans    DeliveryChallan[]
  invoices            SalesInvoice[]
  manufacturingOrders ManufacturingOrder[]

  @@index([soNumber])
  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  soId         String
  so           SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])
  styleCode    String?
  color        String?
  totalQty     Decimal    @db.Decimal(10, 2)
  unitPrice    Decimal    @default(0) @db.Decimal(10, 2)
  discount     Decimal    @default(0) @db.Decimal(5, 2)
  gstRate      Decimal    @default(0) @db.Decimal(5, 2)
  amount       Decimal    @default(0) @db.Decimal(12, 2)
  deliveredQty Decimal    @default(0) @db.Decimal(10, 2)
  pendingQty   Decimal    @default(0) @db.Decimal(10, 2)
  sortOrder    Int        @default(0)

  /// The size run. Rows rather than a JSON blob, so "XL" and "xl" cannot both
  /// exist and the quantities still reconcile at the invoice.
  sizes SalesOrderLineSize[]

  @@map("sales_order_lines")
}

model SalesInvoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  soId          String?
  so            SalesOrder? @relation(fields: [soId], references: [id])
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  invoiceDate   DateTime    @default(now())
  dueDate       DateTime?
  /// Two-digit GST state code of the delivery — compulsory on a tax invoice.
  placeOfSupplyCode String?
  brokerId      String?
  broker        Broker?     @relation(fields: [brokerId], references: [id])
  brokeragePercent Decimal? @db.Decimal(5, 2)
  brokerageAmount Decimal   @default(0) @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  /// A discount given on the whole bill rather than line by line, which is how
  /// LD actually prices. Without it the invoice total cannot be reproduced.
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal     @default(0) @db.Decimal(12, 2)
  cgst          Decimal     @default(0) @db.Decimal(12, 2)
  sgst          Decimal     @default(0) @db.Decimal(12, 2)
  igst          Decimal     @default(0) @db.Decimal(12, 2)
  /// Rounds the bill to the nearest rupee. Without it every total carries paise
  /// and nothing ties out against the customer's ledger.
  roundOff      Decimal     @default(0) @db.Decimal(6, 2)
  totalAmount   Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal     @db.Decimal(12, 2)
  status        InvoiceStatus @default(UNPAID)
  irnNumber     String?
  qrCodeData    String?
  ackNumber     String?
  ackDate       DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payments    PaymentReceipt[]
  lines       SalesInvoiceLine[]
  charges     SalesInvoiceCharge[]
  creditNotes CreditNote[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@map("sales_invoices")
}

model DeliveryChallan {
  id             String     @id @default(cuid())
  dcNumber       String     @unique
  soId           String
  so             SalesOrder @relation(fields: [soId], references: [id])
  dcDate         DateTime   @default(now())
  isReturnable   Boolean    @default(false)
  vehicleNumber  String?
  transporter    String?
  lrNumber       String?
  eWayBillNumber String?
  status         ChallanStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lines DeliveryChallanLine[]

  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id          String          @id @default(cuid())
  dcId        String
  dc          DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)
  description String
  qty         Decimal         @db.Decimal(10, 2)
  uomId       String
  uom         UOM             @relation(fields: [uomId], references: [id])
  sizeBreakup Json?

  @@map("delivery_challan_lines")
}

model PaymentReceipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?
  invoice         SalesInvoice? @relation(fields: [invoiceId], references: [id])
  receiptDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(12, 2)
  mode            PaymentMode
  referenceNo     String?
  chequeDate      DateTime?
  isChequeCleared Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())

  @@map("payment_receipts")
}

// ═══════════════════════════════════════════
// PURCHASE
// ═══════════════════════════════════════════

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  poDate       DateTime            @default(now())
  deliveryDate DateTime?
  status       PurchaseOrderStatus @default(DRAFT)
  poType       String              @default("STANDARD")
  /// Where the goods are delivered, as a two-digit GST state code. Compared
  /// against ours to decide whether the supplier should bill CGST+SGST or IGST.
  placeOfSupplyCode String?
  subtotal     Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount Decimal           @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal            @default(0) @db.Decimal(12, 2)
  /// Split rather than one lump, so the order can be checked against the bill
  /// the supplier eventually sends.
  cgst         Decimal             @default(0) @db.Decimal(12, 2)
  sgst         Decimal             @default(0) @db.Decimal(12, 2)
  igst         Decimal             @default(0) @db.Decimal(12, 2)
  roundOff     Decimal             @default(0) @db.Decimal(6, 2)
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)
  /// Where the supplier is told to deliver.
  deliveryWarehouseId String?
  deliveryWarehouse   Warehouse?   @relation(fields: [deliveryWarehouseId], references: [id])
  notes        String?
  terms        String?
  createdById  String
  createdBy    User                @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines    PurchaseOrderLine[]
  grns     GRN[]
  invoices PurchaseInvoice[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  /// What we asked for in our own words, when it differs from the item name.
  description String?
  /// Copied from the item when the order is raised, because an item's HSN can
  /// be corrected later and an order already sent must not change.
  hsnCode     String?
  qty         Decimal       @db.Decimal(10, 3)
  unitRate    Decimal       @default(0) @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(5, 2)
  gstRate     Decimal       @default(0) @db.Decimal(5, 2)
  amount      Decimal       @default(0) @db.Decimal(12, 2)
  receivedQty Decimal       @default(0) @db.Decimal(10, 3)
  pendingQty  Decimal       @default(0) @db.Decimal(10, 3)
  sortOrder   Int           @default(0)

  grnLines GRNLine[]

  @@map("purchase_order_lines")
}

model GRN {
  id        String        @id @default(cuid())
  grnNumber String        @unique
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id])
  grnDate   DateTime      @default(now())
  vehicleNo String?
  status    GRNStatus     @default(DRAFT)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lines     GRNLine[]
  qcRecords InwardQC[]

  @@map("grn")
}

model GRNLine {
  id           String             @id @default(cuid())
  grnId        String
  grn          GRN                @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId     String?
  poLine       PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  itemId       String
  item         Item               @relation(fields: [itemId], references: [id])
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  orderedQty   Decimal            @db.Decimal(10, 3)
  receivedQty  Decimal            @db.Decimal(10, 3)
  rejectedQty  Decimal            @default(0) @db.Decimal(10, 3)
  acceptedQty  Decimal            @db.Decimal(10, 3)
  batchNumber  String?
  batchDetails Json?
  unitRate     Decimal            @default(0) @db.Decimal(10, 2)
  amount       Decimal            @default(0) @db.Decimal(12, 2)

  @@map("grn_lines")
}

model InwardQC {
  id             String   @id @default(cuid())
  grnId          String
  grn            GRN      @relation(fields: [grnId], references: [id])
  inspectedBy    String?
  inspectionDate DateTime @default(now())
  result         QCResult
  checklistData  Json?
  remarks        String?
  createdAt      DateTime @default(now())

  @@map("inward_qc")
}

model PurchaseInvoice {
  id                  String         @id @default(cuid())
  billNumber          String         @unique
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  supplierId          String
  supplier            Supplier       @relation(fields: [supplierId], references: [id])
  poId                String?
  po                  PurchaseOrder? @relation(fields: [poId], references: [id])
  billDate            DateTime       @default(now())
  dueDate             DateTime?
  subtotal            Decimal        @db.Decimal(12, 2)
  discountAmount      Decimal        @default(0) @db.Decimal(12, 2)
  taxableAmount       Decimal        @default(0) @db.Decimal(12, 2)
  cgst                Decimal        @default(0) @db.Decimal(12, 2)
  sgst                Decimal        @default(0) @db.Decimal(12, 2)
  igst                Decimal        @default(0) @db.Decimal(12, 2)
  /// Tax deducted at source on a contractor or brokerage bill. Recorded here so
  /// the payment of the net amount still settles the bill in full instead of
  /// leaving a permanent stub outstanding against the supplier.
  tdsSection          String?
  tdsRate             Decimal?       @db.Decimal(5, 2)
  tdsAmount           Decimal        @default(0) @db.Decimal(12, 2)
  /// GST payable by us rather than the supplier — common on transport and on
  /// bills from unregistered parties.
  isReverseCharge     Boolean        @default(false)
  roundOff            Decimal        @default(0) @db.Decimal(6, 2)
  totalAmount         Decimal        @db.Decimal(12, 2)
  paidAmount          Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount       Decimal        @db.Decimal(12, 2)
  status              InvoiceStatus  @default(UNPAID)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  payments   SupplierPayment[]
  lines      PurchaseInvoiceLine[]
  charges    PurchaseInvoiceCharge[]
  debitNotes DebitNote[]

  @@map("purchase_invoices")
}

model SupplierPayment {
  id            String           @id @default(cuid())
  paymentNumber String           @unique
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  invoiceId     String?
  invoice       PurchaseInvoice? @relation(fields: [invoiceId], references: [id])
  paymentDate   DateTime         @default(now())
  amount        Decimal          @db.Decimal(12, 2)
  mode          PaymentMode
  referenceNo   String?
  chequeDate    DateTime?
  notes         String?
  createdAt     DateTime         @default(now())

  @@map("supplier_payments")
}

// ═══════════════════════════════════════════
// INVENTORY
// ═══════════════════════════════════════════

model StockLedger {
  id              String          @id @default(cuid())
  itemId          String
  item            Item            @relation(fields: [itemId], references: [id])
  warehouseId     String
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  transactionType TransactionType
  referenceType   String?
  referenceId     String?
  batchNumber     String?
  /// Fabric a customer sends in for job work sits in our godown but is not our
  /// stock. Counting it as ours would inflate the stock value, the balance
  /// sheet and the GST position.
  ownership       StockOwnership  @default(OWNED)
  ownerCustomerId String?
  ownerCustomer   Customer?       @relation("CustomerOwnedStock", fields: [ownerCustomerId], references: [id])
  inQty           Decimal         @default(0) @db.Decimal(10, 3)
  outQty          Decimal         @default(0) @db.Decimal(10, 3)
  closingStock    Decimal         @db.Decimal(10, 3)
  unitRate        Decimal?        @db.Decimal(10, 2)
  transactionDate DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([itemId, warehouseId])
  @@index([transactionDate])
  @@index([ownership, ownerCustomerId])
  @@map("stock_ledger")
}

/// A department asking the store for material. This is the document that takes
/// stock out for production, so it carries three different people: who asked,
/// who allowed it, and who actually handed it over. They are separate columns
/// because docs/04-business-rules.md forbids the person who raised a document
/// from approving it, and that rule cannot be enforced against a single name.
model MaterialRequisition {
  id           String              @id @default(cuid())
  mrNumber     String              @unique
  moId         String?
  mo           ManufacturingOrder? @relation(fields: [moId], references: [id])
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id])
  requestDate  DateTime            @default(now())
  requiredDate DateTime?
  status       ApprovalStatus      @default(PENDING)
  raisedById   String?
  raisedBy     User?               @relation("MRRaisedBy", fields: [raisedById], references: [id])
  approvedById String?
  approvedBy   User?               @relation("MRApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  /// Set the moment stock actually moves. A requisition can be approved on
  /// Monday and issued on Wednesday, and the stock date is Wednesday.
  issuedById   String?
  issuedBy     User?               @relation("MRIssuedBy", fields: [issuedById], references: [id])
  issuedAt     DateTime?
  /// Why it was refused. A rejection with no reason just gets raised again.
  rejectionReason String?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines MaterialRequisitionLine[]

  @@index([status])
  @@map("material_requisitions")
}

model MaterialRequisitionLine {
  id           String              @id @default(cuid())
  mrId         String
  mr           MaterialRequisition @relation(fields: [mrId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item                @relation(fields: [itemId], references: [id])
  requestedQty Decimal             @db.Decimal(10, 3)
  issuedQty    Decimal             @default(0) @db.Decimal(10, 3)
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  purpose      String?

  @@map("material_requisition_lines")
}

// ═══════════════════════════════════════════
// PRODUCTION
// ═══════════════════════════════════════════

model ManufacturingOrder {
  id               String      @id @default(cuid())
  moNumber         String      @unique
  soId             String?
  so               SalesOrder? @relation(fields: [soId], references: [id])
  brandId          String
  brand            Brand       @relation(fields: [brandId], references: [id])
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  status           MOStatus    @default(DRAFT)
  totalPlannedQty  Int         @default(0)
  totalCutQty      Int         @default(0)
  totalStitchedQty Int         @default(0)
  totalFinishedQty Int         @default(0)
  totalPackedQty   Int         @default(0)
  notes            String?
  createdById      String
  createdBy        User        @relation("MOCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  lines                MOLine[]
  materialRequisitions MaterialRequisition[]
  cuttingOrders        CuttingOrder[]
  productionEntries    ProductionEntry[]
  qcRecords            ProductionQC[]
  packingOrders        PackingOrder[]

  @@index([moNumber])
  @@index([status])
  @@map("manufacturing_orders")
}

model MOLine {
  id          String             @id @default(cuid())
  moId        String
  mo          ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  styleId     String
  style       Style              @relation(fields: [styleId], references: [id])
  color       String
  totalQty    Int

  sizes MOLineSize[]

  @@map("mo_lines")
}

model CuttingOrder {
  id               String             @id @default(cuid())
  cutOrderNumber   String             @unique
  moId             String
  mo               ManufacturingOrder @relation(fields: [moId], references: [id])
  cutDate          DateTime           @default(now())
  fabricWidth      Decimal?           @db.Decimal(5, 2)
  fabricGSM        Int?
  shrinkagePercent Decimal?           @db.Decimal(4, 2)
  noOfLayers       Int?
  fabricIssued     Decimal?           @db.Decimal(10, 3)
  fabricUsed       Decimal?           @db.Decimal(10, 3)
  wastage          Decimal?           @db.Decimal(10, 3)
  plannedPieces    Int
  actualPieces     Int                @default(0)
  sizeBreakup      Json?
  status           CuttingStatus      @default(PENDING)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("cutting_orders")
}

model ProductionEntry {
  id          String             @id @default(cuid())
  moId        String
  mo          ManufacturingOrder @relation(fields: [moId], references: [id])
  entryDate   DateTime           @default(now())
  departmentId String
  department  Department         @relation(fields: [departmentId], references: [id])
  /// Which line or outside unit produced this. Without it, what is owed to a
  /// job-work unit can never be totalled.
  workstationId String?
  workstation Workstation?       @relation(fields: [workstationId], references: [id])
  shift       String?
  target      Int
  achieved    Int
  rejection   Int                @default(0)
  rework      Int                @default(0)
  efficiency  Decimal?           @db.Decimal(5, 2)
  operationId String?
  operation   Operation?         @relation(fields: [operationId], references: [id])
  notes       String?
  enteredBy   String?
  createdAt   DateTime           @default(now())

  @@index([moId])
  @@index([entryDate])
  @@map("production_entries")
}

model ProductionQC {
  id           String             @id @default(cuid())
  moId         String
  mo           ManufacturingOrder @relation(fields: [moId], references: [id])
  qcType       String
  qcDate       DateTime           @default(now())
  inspectedQty Int
  passQty      Int
  failQty      Int
  reworkQty    Int                @default(0)
  dhu          Decimal?           @db.Decimal(5, 2)
  aqlLevel     String?
  defects      Json?
  result       QCResult
  inspector    String?
  notes        String?
  createdAt    DateTime           @default(now())

  @@map("production_qc")
}

model PackingOrder {
  id            String             @id @default(cuid())
  packingNumber String             @unique
  moId          String
  mo            ManufacturingOrder @relation(fields: [moId], references: [id])
  packingDate   DateTime           @default(now())
  packingType   String             @default("FLAT")
  totalCartons  Int                @default(0)
  totalPieces   Int                @default(0)
  assortment    Json?
  status        PackingStatus      @default(IN_PROGRESS)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  cartons Carton[]

  @@map("packing_orders")
}

model Carton {
  id             String       @id @default(cuid())
  cartonNumber   String       @unique
  packingOrderId String
  packingOrder   PackingOrder @relation(fields: [packingOrderId], references: [id])
  grossWeight    Decimal?     @db.Decimal(8, 3)
  netWeight      Decimal?     @db.Decimal(8, 3)
  dimensions     String?
  contents       Json
  totalPieces    Int

  @@map("cartons")
}

// ═══════════════════════════════════════════
// ACCOUNTS
// ═══════════════════════════════════════════

model Account {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  groupType      String
  parentId       String?
  parent         Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[] @relation("AccountHierarchy")
  costCenter     String?
  isActive       Boolean   @default(true)
  openingBalance Decimal   @default(0) @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())

  voucherLines VoucherLine[]

  @@map("accounts")
}

model Voucher {
  id          String      @id @default(cuid())
  voucherNo   String      @unique
  type        VoucherType
  date        DateTime    @default(now())
  narration   String?
  totalAmount Decimal     @db.Decimal(14, 2)
  isPosted    Boolean     @default(false)
  reference   String?
  createdBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines VoucherLine[]

  @@index([voucherNo])
  @@index([date])
  @@map("vouchers")
}

model VoucherLine {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  narration String?
  sortOrder Int     @default(0)

  @@map("voucher_lines")
}

model BankAccount {
  id             String   @id @default(cuid())
  accountName    String
  bankName       String
  accountNumber  String
  ifscCode       String
  branch         String?
  accountType    String   @default("CURRENT")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("bank_accounts")
}

// ═══════════════════════════════════════════
// HR & PAYROLL
// ═══════════════════════════════════════════

model Employee {
  id                String           @id @default(cuid())
  employeeCode      String           @unique
  name              String
  email             String?          @unique
  phone             String?
  departmentId      String
  department        Department       @relation(fields: [departmentId], references: [id])
  designation       String?
  employmentType    EmploymentType   @default(PERMANENT)
  joinDate          DateTime
  exitDate          DateTime?
  bankName          String?
  bankAccount       String?
  bankIFSC          String?
  pan               String?
  aadhaar           String?
  pfNumber          String?
  esicNumber        String?
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  photoUrl          String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attendance     Attendance[]
  payrollRecords PayrollRecord[]

  @@index([employeeCode])
  @@map("employees")
}

model SalaryStructure {
  id               String   @id @default(cuid())
  name             String   @unique
  basic            Decimal  @db.Decimal(10, 2)
  hra              Decimal  @default(0) @db.Decimal(10, 2)
  da               Decimal  @default(0) @db.Decimal(10, 2)
  conveyance       Decimal  @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal  @default(0) @db.Decimal(10, 2)
  pfApplicable     Boolean  @default(true)
  esicApplicable   Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  employees Employee[]

  @@map("salary_structures")
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  inTime     DateTime?
  outTime    DateTime?
  workHours  Decimal?         @db.Decimal(4, 2)
  overtime   Decimal?         @db.Decimal(4, 2)
  leaveType  String?
  notes      String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

model PayrollRecord {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  month            Int
  year             Int
  workingDays      Int
  presentDays      Decimal   @db.Decimal(5, 2)
  lwpDays          Decimal   @default(0) @db.Decimal(5, 2)
  basic            Decimal   @db.Decimal(10, 2)
  hra              Decimal   @default(0) @db.Decimal(10, 2)
  da               Decimal   @default(0) @db.Decimal(10, 2)
  conveyance       Decimal   @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal   @default(0) @db.Decimal(10, 2)
  otherEarnings    Decimal   @default(0) @db.Decimal(10, 2)
  grossSalary      Decimal   @db.Decimal(10, 2)
  pfDeduction      Decimal   @default(0) @db.Decimal(10, 2)
  esicDeduction    Decimal   @default(0) @db.Decimal(10, 2)
  tdsDeduction     Decimal   @default(0) @db.Decimal(10, 2)
  advanceDeduction Decimal   @default(0) @db.Decimal(10, 2)
  otherDeductions  Decimal   @default(0) @db.Decimal(10, 2)
  totalDeductions  Decimal   @db.Decimal(10, 2)
  netSalary        Decimal   @db.Decimal(10, 2)
  isPaid           Boolean   @default(false)
  paidDate         DateTime?
  paymentMode      PaymentMode?
  payslipUrl       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([employeeId, month, year])
  @@map("payroll_records")
}

// ═══════════════════════════════════════════
// MACHINE MAINTENANCE
// ═══════════════════════════════════════════

model MachineBreakdown {
  id             String    @id @default(cuid())
  machineId      String
  machine        Machine   @relation(fields: [machineId], references: [id])
  reportedAt     DateTime  @default(now())
  reportedBy     String?
  problemDesc    String
  severity       String    @default("MEDIUM")
  assignedTo     String?
  resolvedAt     DateTime?
  resolutionDesc String?
  downtimeHours  Decimal?  @db.Decimal(6, 2)
  status         BreakdownStatus @default(OPEN)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("machine_breakdowns")
}

model MaintenanceSchedule {
  id              String    @id @default(cuid())
  machineId       String
  machine         Machine   @relation(fields: [machineId], references: [id])
  maintenanceType String
  title           String
  checklistItems  Json?
  scheduledDate   DateTime
  completedDate   DateTime?
  completedBy     String?
  status          MaintenanceStatus @default(PENDING)
  notes           String?
  createdAt       DateTime  @default(now())

  @@map("maintenance_schedules")
}

// ═══════════════════════════════════════════
// AI & NOTIFICATIONS
// ═══════════════════════════════════════════

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String   @default("IN_APP")
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  toolCalls      Json?
  toolResults    Json?
  tokenCount     Int?
  createdAt      DateTime       @default(now())

  @@map("ai_messages")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String
  message   String
  type      String
  isRead    Boolean             @default(false)
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ═══════════════════════════════════════════
// PARTIES — AGENTS
// ═══════════════════════════════════════════

/// A commission agent who brings buyers. LD runs eleven of them plus "SELF" for
/// direct sales, pays brokerage on the invoice value, and deducts TDS under
/// section 194H — so this is real money that needs a ledger, not a note.
model Broker {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  address          String?
  city             String?
  state            String?
  stateCode        String?
  /// Default commission, overridable per customer and per order.
  brokeragePercent Decimal  @default(0) @db.Decimal(5, 2)
  /// TDS section applied to this agent's commission, e.g. "194H".
  tdsSection       String?
  tdsRate          Decimal? @db.Decimal(5, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customers    Customer[]
  salesOrders  SalesOrder[]
  invoices     SalesInvoice[]

  @@index([code])
  @@map("brokers")
}

// ═══════════════════════════════════════════
// SHOP FLOOR — WORKSTATIONS, ROUTING, SIZES
// ═══════════════════════════════════════════

/// Where work physically happens. At LD most of these are not machines on our
/// own floor — many are outside job-work units. Linking one to the supplier
/// Enterprises. Linking one to a supplier is what makes their job-work bill
/// addable at the end of the month.
model Workstation {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  type           WorkstationType @default(IN_HOUSE)
  /// Set when type is JOB_WORK — the party we pay for this work.
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  capacityPerDay Int?
  address        String?
  contactPerson  String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  productionEntries ProductionEntry[]
  routingSteps      RoutingStep[]

  @@index([code])
  @@map("workstations")
}

/// The ordered path a style takes through the factory. No two styles take the
/// same one: a plain shirt skips washing, an embroidered one adds two steps.
model Routing {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  styleId   String
  style     Style    @relation(fields: [styleId], references: [id])
  /// Locked routings cannot be edited while orders are running against them.
  isLocked  Boolean  @default(false)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps RoutingStep[]
  boms  BOM[]

  @@index([styleId])
  @@map("routings")
}

model RoutingStep {
  id            String       @id @default(cuid())
  routingId     String
  routing       Routing      @relation(fields: [routingId], references: [id], onDelete: Cascade)
  sequence      Int
  operationId   String
  operation     Operation    @relation(fields: [operationId], references: [id])
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  /// Optional: the specific unit this step is normally sent to.
  workstationId String?
  workstation   Workstation? @relation(fields: [workstationId], references: [id])
  smv           Decimal?     @db.Decimal(5, 3)
  ratePerPiece  Decimal?     @db.Decimal(10, 2)
  isQcStep      Boolean      @default(false)

  @@unique([routingId, sequence])
  @@map("routing_steps")
}

/// A named size run, e.g. "Men's Shirt S–XXL". Replaces free-text size arrays.
model SizeGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  gender    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sizes  Size[]
  styles Style[]

  @@map("size_groups")
}

model Size {
  id          String    @id @default(cuid())
  sizeGroupId String
  sizeGroup   SizeGroup @relation(fields: [sizeGroupId], references: [id], onDelete: Cascade)
  code        String
  label       String
  sequence    Int       @default(0)

  soLineSizes  SalesOrderLineSize[]
  moLineSizes  MOLineSize[]
  bomLineSizes BOMLineSize[]
  baseSizeBoms BOM[]

  @@unique([sizeGroupId, code])
  @@map("sizes")
}

model SalesOrderLineSize {
  id     String         @id @default(cuid())
  lineId String
  line   SalesOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sizeId String
  size   Size           @relation(fields: [sizeId], references: [id])
  qty    Decimal        @db.Decimal(10, 2)

  @@unique([lineId, sizeId])
  @@map("sales_order_line_sizes")
}

model MOLineSize {
  id       String  @id @default(cuid())
  moLineId String
  moLine   MOLine  @relation(fields: [moLineId], references: [id], onDelete: Cascade)
  sizeId   String
  size     Size    @relation(fields: [sizeId], references: [id])
  qty      Int

  @@unique([moLineId, sizeId])
  @@map("mo_line_sizes")
}

// ═══════════════════════════════════════════
// DOCUMENT LINES AND CHARGES
// ═══════════════════════════════════════════

model SalesInvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item         @relation(fields: [itemId], references: [id])
  description String?
  /// Copied onto the line at the time of billing, because an item's HSN can be
  /// corrected later and an issued invoice must never change.
  hsnCode     String?
  qty         Decimal      @db.Decimal(10, 3)
  unitPrice   Decimal      @db.Decimal(10, 2)
  discount    Decimal      @default(0) @db.Decimal(5, 2)
  taxableValue Decimal     @default(0) @db.Decimal(12, 2)
  gstRate     Decimal      @default(0) @db.Decimal(5, 2)
  cgst        Decimal      @default(0) @db.Decimal(12, 2)
  sgst        Decimal      @default(0) @db.Decimal(12, 2)
  igst        Decimal      @default(0) @db.Decimal(12, 2)
  amount      Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder   Int          @default(0)

  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

model PurchaseInvoiceLine {
  id           String          @id @default(cuid())
  billId       String
  bill         PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item            @relation(fields: [itemId], references: [id])
  description  String?
  hsnCode      String?
  qty          Decimal         @db.Decimal(10, 3)
  unitPrice    Decimal         @db.Decimal(10, 2)
  discount     Decimal         @default(0) @db.Decimal(5, 2)
  taxableValue Decimal         @default(0) @db.Decimal(12, 2)
  gstRate      Decimal         @default(0) @db.Decimal(5, 2)
  cgst         Decimal         @default(0) @db.Decimal(12, 2)
  sgst         Decimal         @default(0) @db.Decimal(12, 2)
  igst         Decimal         @default(0) @db.Decimal(12, 2)
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  sortOrder    Int             @default(0)

  @@index([billId])
  @@map("purchase_invoice_lines")
}

/// The chargeable extras LD already bills: transport, freight, dyeing. Each
/// carries its own GST rate, so it cannot be folded into the goods value.
model ChargeType {
  id              String   @id @default(cuid())
  name            String   @unique
  defaultGstRate  Decimal  @default(0) @db.Decimal(5, 2)
  applyOnSale     Boolean  @default(true)
  applyOnPurchase Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  salesCharges    SalesInvoiceCharge[]
  purchaseCharges PurchaseInvoiceCharge[]

  @@map("charge_types")
}

model SalesInvoiceCharge {
  id           String       @id @default(cuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  chargeTypeId String
  chargeType   ChargeType   @relation(fields: [chargeTypeId], references: [id])
  amount       Decimal      @db.Decimal(12, 2)
  gstRate      Decimal      @default(0) @db.Decimal(5, 2)
  cgst         Decimal      @default(0) @db.Decimal(12, 2)
  sgst         Decimal      @default(0) @db.Decimal(12, 2)
  igst         Decimal      @default(0) @db.Decimal(12, 2)

  @@map("sales_invoice_charges")
}

model PurchaseInvoiceCharge {
  id           String          @id @default(cuid())
  billId       String
  bill         PurchaseInvoice @relation(fields: [billId], references: [id], onDelete: Cascade)
  chargeTypeId String
  chargeType   ChargeType      @relation(fields: [chargeTypeId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  gstRate      Decimal         @default(0) @db.Decimal(5, 2)
  cgst         Decimal         @default(0) @db.Decimal(12, 2)
  sgst         Decimal         @default(0) @db.Decimal(12, 2)
  igst         Decimal         @default(0) @db.Decimal(12, 2)

  @@map("purchase_invoice_charges")
}

// ═══════════════════════════════════════════
// RETURNS
// ═══════════════════════════════════════════

/// Issued to a customer when goods come back or a bill is reduced. Without it a
/// return leaves the original invoice standing and overstates GST payable.
model CreditNote {
  id          String        @id @default(cuid())
  noteNumber  String        @unique
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceId   String?
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  noteDate    DateTime      @default(now())
  reason      String?
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  cgst        Decimal       @default(0) @db.Decimal(12, 2)
  sgst        Decimal       @default(0) @db.Decimal(12, 2)
  igst        Decimal       @default(0) @db.Decimal(12, 2)
  roundOff    Decimal       @default(0) @db.Decimal(6, 2)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  status      NoteStatus    @default(DRAFT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines CreditNoteLine[]

  @@index([customerId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  noteId       String
  note         CreditNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id])
  description  String?
  hsnCode      String?
  qty          Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 2)
  taxableValue Decimal    @default(0) @db.Decimal(12, 2)
  gstRate      Decimal    @default(0) @db.Decimal(5, 2)
  amount       Decimal    @default(0) @db.Decimal(12, 2)
  sortOrder    Int        @default(0)

  @@map("credit_note_lines")
}

/// Raised against a supplier — short supply, rejected goods, a rate correction.
model DebitNote {
  id          String           @id @default(cuid())
  noteNumber  String           @unique
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  billId      String?
  bill        PurchaseInvoice? @relation(fields: [billId], references: [id])
  noteDate    DateTime         @default(now())
  reason      String?
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  cgst        Decimal          @default(0) @db.Decimal(12, 2)
  sgst        Decimal          @default(0) @db.Decimal(12, 2)
  igst        Decimal          @default(0) @db.Decimal(12, 2)
  roundOff    Decimal          @default(0) @db.Decimal(6, 2)
  totalAmount Decimal          @default(0) @db.Decimal(12, 2)
  status      NoteStatus       @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lines DebitNoteLine[]

  @@index([supplierId])
  @@map("debit_notes")
}

model DebitNoteLine {
  id           String    @id @default(cuid())
  noteId       String
  note         DebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  description  String?
  hsnCode      String?
  qty          Decimal   @db.Decimal(10, 3)
  unitPrice    Decimal   @db.Decimal(10, 2)
  taxableValue Decimal   @default(0) @db.Decimal(12, 2)
  gstRate      Decimal   @default(0) @db.Decimal(5, 2)
  amount       Decimal   @default(0) @db.Decimal(12, 2)
  sortOrder    Int       @default(0)

  @@map("debit_note_lines")
}

// ═══════════════════════════════════════════
// PRINTED DOCUMENTS
// ═══════════════════════════════════════════

/// What appears on one kind of printed document.
///
/// Deliberately not a layout editor. The arrangement of an Indian tax invoice
/// is fixed by what the law requires on it, so there is nothing useful to drag
/// around. What genuinely varies between businesses is the wording and which
/// optional blocks are shown, and that is all this holds.
model DocumentTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// INV, PO, DC, JW — matches the document numbering series.
  docType   String
  /// Printed as the heading, e.g. "TAX INVOICE" or "DELIVERY CHALLAN".
  title     String

  /// Long-form terms printed at the foot.
  termsText   String?
  /// The line an Indian invoice normally carries certifying the particulars.
  declaration String?
  /// A short line under everything else, such as jurisdiction.
  footerNote  String?

  showHsn           Boolean @default(true)
  showAmountInWords Boolean @default(true)
  showBankDetails   Boolean @default(true)
  showSignature     Boolean @default(true)
  /// Copy labels printed one per page, e.g. Original for Recipient.
  copies            String[]

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([companyId, docType])
  @@map("document_templates")
}
