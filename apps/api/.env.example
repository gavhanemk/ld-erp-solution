# LD ERP Solution — API Environment Variables
# Copy to .env for local dev

NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://lderpuser:lderppassword@localhost:5432/lderp_db"

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# AI assistant — set ONE of these, or neither and add the key in
# Settings → Assistant instead, which is the better place for it.
# A key here works, but only somebody who can edit this file can change it.

# OpenAI. Paid per question. From platform.openai.com → API keys.
# OPENAI_API_KEY is the usual name; OPEN_AI_API_KEY is accepted too.
OPENAI_API_KEY=your-openai-api-key

# Google Gemini. Has a free tier with daily limits. From aistudio.google.com.
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# CORS
FRONTEND_URL=http://localhost:3000

# Company
COMPANY_NAME=LD Cotton Mills
COMPANY_GSTIN=YOUR_GSTIN_HERE
COMPANY_STATE_CODE=GJ

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=erp@ldcottonmills.com
SMTP_PASS=your-app-password

# WhatsApp Business Cloud API
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ld-erp-webhook-2025

# GST E-Invoice
GST_EINVOICE_BASE_URL=https://einvoice1.gst.gov.in
GST_CLIENT_ID=your-client-id
GST_CLIENT_SECRET=your-client-secret

# Cloudflare R2 (File Storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-key-id
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET_NAME=ld-erp-files
R2_PUBLIC_URL=https://files.ldcottonmills.com
